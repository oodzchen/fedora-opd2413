+	unsigned int		cp_engages;
+	unsigned int		cp_drops;
+
+	/* pump controller (c3) */
+	bool			buck_off;	/* ICL 0 written for the pump */
+	bool			adc_held;	/* sc8547a ADC held on for the session */
+	unsigned long		cp_lift_since;	/* entry request sent (0 = not lifting) */
