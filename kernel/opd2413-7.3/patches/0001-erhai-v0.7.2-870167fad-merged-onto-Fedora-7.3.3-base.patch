+/* reads VBUS through the ADSP (USB_VOLT_NOW in uV) */
+static int pps_read_vbus(struct erhai_pps *p)
+{
+	int v = pps_usb_get(1);			/* USB_VOLT_NOW, uV */
+
+	if (v < 0)
+		return v;
+	p->vbus_mv = v / 1000;
+	return 0;
+}
