+#define SC8547_REG_30			0x30	/* VOOC irq mask */
+#define SC8547_REG_31			0x31	/* predata (word) */
+#define SC8547_REG_33			0x33	/* loose-detect */
+#define SC8547_REG_36			0x36	/* device id */
+#define SC8547_REG_3A			0x3A
