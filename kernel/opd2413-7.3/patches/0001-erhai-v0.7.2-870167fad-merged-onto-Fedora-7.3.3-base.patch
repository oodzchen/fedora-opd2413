+#define TX1_DET_BIT1_MASK		0x02
+#define TX0_DET_BIT0_SHIFT		0
+#define TX0_DET_BIT1_SHIFT		1
+#define TX0_DET_BIT2_SHIFT		2
+#define TX0_DET_BIT3_SHIFT		3
+#define TX0_DET_BIT4_SHIFT		4
