+
+	guard(mutex)(&chip->io_lock);
+	if (chip->suspended || chip->removing || !chip->ready)
+		return -EHOSTDOWN;
+	ret = cps8601_read16(chip, CPS8601_REG_TX_VOLTAGE, &v);
+	return ret ?: sysfs_emit(buf, "%u\n", v);
