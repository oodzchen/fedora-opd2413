+/*
+ * 2x2 binning, from the stock camera module data: the registers that differ
+ * from the full-resolution sequence above. Line length and frame length are
+ * unchanged, so the line time and the frame rate stay the same.
+ */
+static const struct cci_reg_sequence sc820cs_binning[] = {
+	{ CCI_REG8(0x3208), 0x06 },
+	{ CCI_REG8(0x3209), 0x60 },
+	{ CCI_REG8(0x320a), 0x04 },
+	{ CCI_REG8(0x320b), 0xc8 },
+	{ CCI_REG8(0x3213), 0x04 },
+	{ CCI_REG8(0x3215), 0x31 },
+	{ CCI_REG8(0x3220), 0x01 },
+	{ CCI_REG8(0x5000), 0x4e },
+	{ CCI_REG8(0x5900), 0xf1 },
+	{ CCI_REG8(0x5901), 0x04 },
+};
+
+struct sc820cs_mode {
+	u32 width;
+	u32 height;
+	const struct cci_reg_sequence *regs;
+	unsigned int num_regs;
+};
+
+static const struct sc820cs_mode sc820cs_modes[] = {
+	{ .width = SC820CS_WIDTH, .height = SC820CS_HEIGHT },
+	{ .width = 1632, .height = 1224, .regs = sc820cs_binning,
+	  .num_regs = ARRAY_SIZE(sc820cs_binning) },
+};
+
+static int sc820cs_power_on(struct device *dev)
+{
+	struct sc820cs *sensor = to_sc820cs(dev_get_drvdata(dev));
+	int i, ret;
+
+	for (i = 0; i < ARRAY_SIZE(sensor->supplies); i++) {
+		ret = regulator_enable(sensor->supplies[i].consumer);
+		if (ret)
+			goto disable_supplies;
+		usleep_range(1000, 1500);
+	}
+
+	/* Keep reset asserted until the input clock is running. */
+	ret = clk_prepare_enable(sensor->xclk);
+	if (ret)
+		goto disable_supplies;
+	usleep_range(1000, 1500);
+	gpiod_set_value_cansleep(sensor->reset, 0);
+	usleep_range(10000, 12000);
+
+	return 0;
+
+disable_supplies:
+	while (i--) {
+		regulator_disable(sensor->supplies[i].consumer);
+		usleep_range(1000, 1500);
+	}
+	return ret;
+}
+
+static int sc820cs_power_off(struct device *dev)
+{
+	struct sc820cs *sensor = to_sc820cs(dev_get_drvdata(dev));
+	int i;
+
+	clk_disable_unprepare(sensor->xclk);
+	usleep_range(5000, 5500);
+	gpiod_set_value_cansleep(sensor->reset, 1);
+	usleep_range(1000, 1500);
+	for (i = ARRAY_SIZE(sensor->supplies) - 1; i >= 0; i--) {
+		regulator_disable(sensor->supplies[i].consumer);
+		usleep_range(1000, 1500);
+	}
+	return 0;
+}
+
+static int sc820cs_set_exposure(struct sc820cs *sensor, unsigned int lines)
+{
+	/* Exposure is encoded in half-lines in bits 19:4. */
+	return cci_write(sensor->regmap, CCI_REG24(0x3e00), lines << 5, NULL);
+}
+
+static int sc820cs_set_ctrl(struct v4l2_ctrl *ctrl)
+{
+	struct sc820cs *sensor = container_of(ctrl->handler, struct sc820cs, ctrls);
+	static const u8 coarse_gain[] = { 0x00, 0x08, 0x09, 0x0b, 0x0f };
+	unsigned int stage;
+	int ret, exposure_max;
+
+	if (ctrl->id == V4L2_CID_VBLANK) {
+		exposure_max = sensor->mode->height + ctrl->val - SC820CS_EXPOSURE_MARGIN;
+		ret = __v4l2_ctrl_modify_range(sensor->exposure, 2, exposure_max,
+					       1, min(exposure_max, 1000));
+		if (ret)
+			return ret;
+	}
+
+	if (ctrl->id == V4L2_CID_HFLIP || ctrl->id == V4L2_CID_VFLIP) {
+		struct v4l2_subdev_state *state =
+			v4l2_subdev_get_locked_active_state(&sensor->sd);
+
+		v4l2_subdev_state_get_format(state, 0)->code = sc820cs_mbus_code(sensor);
+	}
+
+	ret = pm_runtime_get_if_in_use(sensor->dev);
+	if (ret <= 0)
+		return ret;
+	ret = 0;
+
+	switch (ctrl->id) {
+	case V4L2_CID_EXPOSURE:
+		ret = sc820cs_set_exposure(sensor, ctrl->val);
+		break;
+	case V4L2_CID_VBLANK:
+		/* Clamp the shutter before shortening the frame. */
+		ret = sc820cs_set_exposure(sensor, sensor->exposure->val);
+		cci_write(sensor->regmap, CCI_REG16(0x320e),
+			  sensor->mode->height + ctrl->val, &ret);
+		break;
+	case V4L2_CID_ANALOGUE_GAIN:
+		/* Vendor gain encoding: 1024 represents unity. */
+		stage = fls(ctrl->val / 1024) - 1;
+		cci_write(sensor->regmap, CCI_REG8(0x3e08), coarse_gain[stage], &ret);
+		cci_write(sensor->regmap, CCI_REG8(0x3e07),
+			  (ctrl->val >> stage) >> 3, &ret);
+		break;
+	case V4L2_CID_HFLIP:
+	case V4L2_CID_VFLIP:
+		ret = cci_write(sensor->regmap, SC820CS_REG_MIRROR_FLIP,
+				(sensor->hflip->val ? SC820CS_MIRROR : 0) |
+				(sensor->vflip->val ? SC820CS_FLIP : 0), NULL);
+		break;
+	default:
+		ret = -EINVAL;
+		break;
+	}
+	pm_runtime_put(sensor->dev);
+	return ret;
+}
+
+static const struct v4l2_ctrl_ops sc820cs_ctrl_ops = {
+	.s_ctrl = sc820cs_set_ctrl,
+};
+
+static int sc820cs_init_controls(struct sc820cs *sensor)
+{
+	struct v4l2_ctrl_handler *hdl = &sensor->ctrls;
+	struct v4l2_fwnode_device_properties props;
+	struct v4l2_ctrl *ctrl;
+	int ret;
+
+	v4l2_ctrl_handler_init(hdl, 11);
+	ctrl = v4l2_ctrl_new_int_menu(hdl, NULL, V4L2_CID_LINK_FREQ, 0, 0,
+				      sc820cs_link_freqs);
+	if (ctrl)
+		ctrl->flags |= V4L2_CTRL_FLAG_READ_ONLY;
+	v4l2_ctrl_new_std(hdl, NULL, V4L2_CID_PIXEL_RATE, SC820CS_PIXEL_RATE,
+			  SC820CS_PIXEL_RATE, 1, SC820CS_PIXEL_RATE);
+	sensor->hblank = v4l2_ctrl_new_std(hdl, NULL, V4L2_CID_HBLANK,
+				 SC820CS_LINE_LENGTH - SC820CS_WIDTH,
+				 SC820CS_LINE_LENGTH - SC820CS_WIDTH, 1,
+				 SC820CS_LINE_LENGTH - SC820CS_WIDTH);
+	if (sensor->hblank)
+		sensor->hblank->flags |= V4L2_CTRL_FLAG_READ_ONLY;
+	sensor->vblank = v4l2_ctrl_new_std(hdl, &sc820cs_ctrl_ops, V4L2_CID_VBLANK,
+					 SC820CS_VTS - SC820CS_HEIGHT,
+					 SC820CS_VTS_MAX - SC820CS_HEIGHT, 1,
+					 SC820CS_VTS - SC820CS_HEIGHT);
+	sensor->exposure = v4l2_ctrl_new_std(hdl, &sc820cs_ctrl_ops, V4L2_CID_EXPOSURE,
+					   2, SC820CS_VTS - SC820CS_EXPOSURE_MARGIN,
+					   1, 1000);
+	v4l2_ctrl_new_std(hdl, &sc820cs_ctrl_ops, V4L2_CID_ANALOGUE_GAIN,
+			  1024, 16384, 8, 1024);
+	sensor->hflip = v4l2_ctrl_new_std(hdl, &sc820cs_ctrl_ops, V4L2_CID_HFLIP,
+					0, 1, 1, 0);
+	if (sensor->hflip)
+		sensor->hflip->flags |= V4L2_CTRL_FLAG_MODIFY_LAYOUT;
+	sensor->vflip = v4l2_ctrl_new_std(hdl, &sc820cs_ctrl_ops, V4L2_CID_VFLIP,
+					0, 1, 1, 0);
+	if (sensor->vflip)
+		sensor->vflip->flags |= V4L2_CTRL_FLAG_MODIFY_LAYOUT;
+	if (hdl->error) {
+		ret = hdl->error;
+		goto free_controls;
+	}
+	ret = v4l2_fwnode_device_parse(sensor->dev, &props);
+	if (ret)
+		goto free_controls;
+	ret = v4l2_ctrl_new_fwnode_properties(hdl, &sc820cs_ctrl_ops, &props);
+	if (ret)
+		goto free_controls;
+	sensor->sd.ctrl_handler = hdl;
+	return 0;
+
+free_controls:
+	v4l2_ctrl_handler_free(hdl);
+	return ret;
+}
+
+static int sc820cs_enable_streams(struct v4l2_subdev *sd,
+				 struct v4l2_subdev_state *state,
+				 u32 pad, u64 streams_mask)
+{
+	struct sc820cs *sensor = to_sc820cs(sd);
+	int ret;
+
+	ret = pm_runtime_resume_and_get(sensor->dev);
+	if (ret < 0)
+		return ret;
+	ret = cci_write(sensor->regmap, CCI_REG8(0x0103), 1, NULL);
+	if (ret)
+		goto power_off;
+	usleep_range(10000, 11000);
+	ret = cci_multi_reg_write(sensor->regmap, sc820cs_mode,
+				  ARRAY_SIZE(sc820cs_mode), NULL);
+	if (sensor->mode->num_regs)
+		cci_multi_reg_write(sensor->regmap, sensor->mode->regs,
+				    sensor->mode->num_regs, &ret);
+	cci_write(sensor->regmap, CCI_REG16(0x320c), SC820CS_HTS, &ret);
+	if (ret)
+		goto power_off;
+	ret = __v4l2_ctrl_handler_setup(&sensor->ctrls);
+	if (ret)
+		goto power_off;
+	ret = cci_write(sensor->regmap, CCI_REG8(0x0100), 1, NULL);
+	if (ret)
+		goto power_off;
+	/* The flips change the Bayer order; keep them fixed while streaming. */
+	__v4l2_ctrl_grab(sensor->hflip, true);
+	__v4l2_ctrl_grab(sensor->vflip, true);
+	return 0;
+power_off:
+	pm_runtime_put_sync(sensor->dev);
+	return ret;
+}
+
+static int sc820cs_disable_streams(struct v4l2_subdev *sd,
+				  struct v4l2_subdev_state *state,
+				  u32 pad, u64 streams_mask)
+{
+	struct sc820cs *sensor = to_sc820cs(sd);
+	int ret;
+
+	ret = cci_write(sensor->regmap, CCI_REG8(0x0100), 0, NULL);
+	__v4l2_ctrl_grab(sensor->hflip, false);
+	__v4l2_ctrl_grab(sensor->vflip, false);
+	pm_runtime_put_sync(sensor->dev);
+	return ret;
+}
+
+static int sc820cs_set_format(struct v4l2_subdev *sd,
+			     struct v4l2_subdev_state *state,
+			     struct v4l2_subdev_format *fmt)
+{
+	struct sc820cs *sensor = to_sc820cs(sd);
+	const struct sc820cs_mode *mode;
+	int ret;
+
+	if (fmt->which == V4L2_SUBDEV_FORMAT_ACTIVE && sd->enabled_pads)
+		return -EBUSY;
+
+	mode = v4l2_find_nearest_size(sc820cs_modes, ARRAY_SIZE(sc820cs_modes),
+				      width, height, fmt->format.width,
+				      fmt->format.height);
+	fmt->format = (struct v4l2_mbus_framefmt) {
+		.width = mode->width,
+		.height = mode->height,
+		.code = sc820cs_mbus_code(sensor),
+		.field = V4L2_FIELD_NONE,
+		.colorspace = V4L2_COLORSPACE_RAW,
+		.ycbcr_enc = V4L2_YCBCR_ENC_DEFAULT,
+		.quantization = V4L2_QUANTIZATION_FULL_RANGE,
+		.xfer_func = V4L2_XFER_FUNC_NONE,
+	};
+	*v4l2_subdev_state_get_format(state, 0) = fmt->format;
+	/* Both modes read out the whole array; binning halves each axis. */
+	*v4l2_subdev_state_get_crop(state, 0) = (struct v4l2_rect) {
+		.width = SC820CS_WIDTH,
+		.height = SC820CS_HEIGHT,
+	};
+	if (fmt->which != V4L2_SUBDEV_FORMAT_ACTIVE)
+		return 0;
+
+	sensor->mode = mode;
+	ret = __v4l2_ctrl_modify_range(sensor->hblank,
+				       SC820CS_LINE_LENGTH - mode->width,
+				       SC820CS_LINE_LENGTH - mode->width, 1,
+				       SC820CS_LINE_LENGTH - mode->width);
+	if (ret)
+		return ret;
+	ret = __v4l2_ctrl_modify_range(sensor->vblank,
+				       SC820CS_VTS - mode->height,
+				       SC820CS_VTS_MAX - mode->height,
+				       sensor->vblank->step,
+				       SC820CS_VTS - mode->height);
+	if (ret)
+		return ret;
+	return __v4l2_ctrl_s_ctrl(sensor->vblank, SC820CS_VTS - mode->height);
+}
+
+static int sc820cs_init_state(struct v4l2_subdev *sd,
+			     struct v4l2_subdev_state *state)
+{
+	struct v4l2_subdev_format fmt = { .pad = 0 };
+
+	return sc820cs_set_format(sd, state, &fmt);
+}
+
+static int sc820cs_enum_mbus_code(struct v4l2_subdev *sd,
+				 struct v4l2_subdev_state *state,
+				 struct v4l2_subdev_mbus_code_enum *code)
+{
+	if (code->index)
+		return -EINVAL;
+	code->code = sc820cs_mbus_code(to_sc820cs(sd));
+	return 0;
+}
+
+static int sc820cs_enum_frame_size(struct v4l2_subdev *sd,
+				  struct v4l2_subdev_state *state,
+				  struct v4l2_subdev_frame_size_enum *fse)
+{
+	if (fse->index >= ARRAY_SIZE(sc820cs_modes) ||
+	    fse->code != sc820cs_mbus_code(to_sc820cs(sd)))
+		return -EINVAL;
+	fse->min_width = fse->max_width = sc820cs_modes[fse->index].width;
+	fse->min_height = fse->max_height = sc820cs_modes[fse->index].height;
+	return 0;
+}
+
+static int sc820cs_get_selection(struct v4l2_subdev *sd,
+			       struct v4l2_subdev_state *state,
+			       struct v4l2_subdev_selection *sel)
+{
+	if (sel->pad)
+		return -EINVAL;
+
+	switch (sel->target) {
+	case V4L2_SEL_TGT_CROP:
+	case V4L2_SEL_TGT_CROP_DEFAULT:
+	case V4L2_SEL_TGT_CROP_BOUNDS:
+		sel->r = *v4l2_subdev_state_get_crop(state, 0);
+		return 0;
+	default:
+		return -EINVAL;
+	}
+}
