# OPD2413 options on top of Fedora 45's kernel-aarch64-fedora.config (7.3.3).
# Generated from the drivers the tablet uses under kernel 7.2.6-3.opd2413
# (lsmod and bound drivers, mapped to Kconfig symbols), see docs/M3-KERNEL.md.

# --- Built in, as in kernel 3. The SoC clock, pin, interconnect, UFS and
# display drivers must not depend on the initramfs: dracut's host-only module
# selection was computed on a kernel that had them built in.
CONFIG_ARM_SCMI_CPUFREQ=y
CONFIG_BACKLIGHT_KTZ8866=y
CONFIG_BACKLIGHT_LED=y
CONFIG_DRM_AUX_BRIDGE=y
CONFIG_DRM_AUX_HPD_BRIDGE=y
CONFIG_DRM_MSM=y
CONFIG_HWSPINLOCK_QCOM=y
CONFIG_INPUT_PM8941_PWRKEY=y
CONFIG_INTERCONNECT_QCOM_SM8750=y
CONFIG_KEYBOARD_GPIO=y
CONFIG_NVMEM_QCOM_QFPROM=y
CONFIG_PHY_QCOM_EUSB2_REPEATER=y
CONFIG_PHY_QCOM_M31_EUSB=y
CONFIG_PHY_QCOM_QMP_COMBO=y
CONFIG_PHY_QCOM_QMP_PCIE=y
CONFIG_PHY_QCOM_QMP_UFS=y
CONFIG_PINCTRL_SM8750=y
CONFIG_POWER_RESET_QCOM_PON=y
CONFIG_POWER_SEQUENCING_QCOM_WCN=y
CONFIG_PSTORE_RAM=y
CONFIG_QCOM_AOSS_QMP=y
CONFIG_QCOM_APR=y
CONFIG_QCOM_CPUCP_MBOX=y
CONFIG_QCOM_FASTRPC=y
CONFIG_QCOM_GPI_DMA=y
CONFIG_QCOM_ICC_BWMON=y
CONFIG_QCOM_IPCC=y
CONFIG_QCOM_LLCC=y
CONFIG_QCOM_PD_MAPPER=y
CONFIG_QCOM_PMIC_GLINK=y
CONFIG_QCOM_Q6V5_PAS=y
CONFIG_QCOM_SMEM=y
CONFIG_QCOM_SMP2P=y
CONFIG_QCOM_SOCINFO=y
CONFIG_QCOM_SPMI_TEMP_ALARM=y
CONFIG_QCOM_STATS=y
CONFIG_QCOM_TSENS=y
CONFIG_QRTR_MHI=y
CONFIG_QRTR_SMD=y
CONFIG_RPMSG_CTRL=y
CONFIG_SCSI_UFS_QCOM=y
CONFIG_SM_DISPCC_8750=y
CONFIG_SM_GCC_8750=y
CONFIG_SM_GPUCC_8750=y
CONFIG_SM_TCSRCC_8750=y
CONFIG_SM_VIDEOCC_8750=y
CONFIG_SPI_QCOM_GENI=y
CONFIG_TYPEC_MUX_WCD939X_USBSS=y
CONFIG_UCSI_PMIC_GLINK=y
CONFIG_USB_DWC3_QCOM=y

# --- Modules the tablet loads under kernel 3 that Fedora leaves out.
CONFIG_HW_RANDOM_QCOM=m
CONFIG_KEYBOARD_ONEPLUS_POGO=m
CONFIG_PINCTRL_SM8650_LPASS_LPI=m
CONFIG_SM_CAMCC_8750=m

# --- Board drivers (panel and touch are built in, as in kernel 3).
CONFIG_DRM_PANEL_NOVATEK_NT36536_XN242=y
CONFIG_TOUCHSCREEN_NT36536_SPI=y

# --- erhai additions. The PPS engine starts disabled through
# /etc/modprobe.d until it is verified on its own (M3b).
CONFIG_CHARGER_SC8547A=m
CONFIG_CHARGER_ERHAI_PPS=m
CONFIG_VIDEO_QCOM_CAMSS=m
CONFIG_I2C_QCOM_CCI=m
CONFIG_PHY_QCOM_MIPI_CSI2=m
CONFIG_VIDEO_SC1300CS=m
CONFIG_VIDEO_SC820CS=m
CONFIG_VIDEO_CN3927=m
# Stylus charging is out of scope.
# CONFIG_CHARGER_CPS8601 is not set

# --- Parents that must be built in for the options above (from kernel 3).
CONFIG_IIO=y
CONFIG_MHI_BUS=y
CONFIG_PHY_QCOM_QMP=y
CONFIG_QCOM_OCMEM=y
CONFIG_QCOM_SYSMON=y
CONFIG_QRTR=y
CONFIG_RPMSG=y
CONFIG_RPMSG_CHAR=y
CONFIG_RPMSG_QCOM_GLINK=y
CONFIG_RPMSG_QCOM_GLINK_SMEM=y
CONFIG_RPMSG_QCOM_SMD=y
CONFIG_SCSI_UFSHCD_PLATFORM=y
CONFIG_TYPEC=y
CONFIG_TYPEC_UCSI=y
CONFIG_USB_DWC3=y
CONFIG_SCSI_UFSHCD=y
CONFIG_RPMB=y
