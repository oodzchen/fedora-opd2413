# M3.3 / Power Batch 2: Permit native PCIe hotplug-capable Root Ports to enter
# D3 during suspend (paired with patch 2425 / upstream d4c79b63d82d and
# removing pcie_ports=compat from kernel cmdline).
# From erhai commit 630d15278 ("arm64: configs: erhai: enable native PCIe hotplug").
CONFIG_HOTPLUG_PCI_PCIE=y
