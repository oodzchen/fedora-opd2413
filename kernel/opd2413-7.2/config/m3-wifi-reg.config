# Wi-Fi user regulatory hints for WCN7860 (5 GHz AP / p2p0 NetShare).
# Matches erhai-firstboot.config: ath12k checks CONFIG_ATH_REG_DYNAMIC_USER_REG_HINTS
# (drivers/net/wireless/ath/ath12k/reg.c), which depends on
# CONFIG_CFG80211_CERTIFICATION_ONUS (and CONFIG_EXPERT). Allows
# /etc/sysconfig/regdomain (COUNTRY=CN via udev setregdomain at boot) to unlock
# non-DFS 5 GHz AP channels before wlp1s0 associates.
CONFIG_EXPERT=y
CONFIG_CFG80211_CERTIFICATION_ONUS=y
CONFIG_ATH_REG_DYNAMIC_USER_REG_HINTS=y
