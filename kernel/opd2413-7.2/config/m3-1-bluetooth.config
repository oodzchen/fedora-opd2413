# M3.1 Bluetooth: the profiles the desktop uses that kernel 3's config leaves out.
# From erhai commit eb313ec77 ("enable the Bluetooth profiles the desktop uses"),
# kept modular like the rest of this kernel's Bluetooth stack and Fedora's config.
# BT_LE, BT_LE_L2CAP_ECRED, BT_HIDP and UHID are already on in kernel 3.
#
# RFCOMM TTY: serial port profile (/dev/rfcomm*); RFCOMM itself is already a module.
CONFIG_BT_RFCOMM_TTY=y
# BNEP: Bluetooth network tethering (PAN), as in Fedora's kernel.
CONFIG_BT_BNEP=m
CONFIG_BT_BNEP_MC_FILTER=y
CONFIG_BT_BNEP_PROTO_FILTER=y
