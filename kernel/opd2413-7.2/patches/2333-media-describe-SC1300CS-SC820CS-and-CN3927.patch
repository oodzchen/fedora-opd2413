Date: Fri, 23 Oct 2026 21:06:35 +0800
Subject: [PATCH] dt-bindings: media: describe SC1300CS, SC820CS and CN3927

Describe the SmartSens image sensors and Chipnext lens actuator, their
supplies, reset signals and CSI-2 interfaces. Register the vendor prefixes.

Assisted-by: LLM
Co-Authored-By: Claude Fable 5.1 <noreply@anthropic.com>
---
 .../bindings/media/i2c/chipnext,cn3927.yaml   |  48 +++++++++
 .../media/i2c/smartsens,sc1300cs.yaml         | 101 ++++++++++++++++++
 .../bindings/media/i2c/smartsens,sc820cs.yaml | 101 ++++++++++++++++++
 .../devicetree/bindings/vendor-prefixes.yaml  |   4 +
 4 files changed, 254 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/media/i2c/chipnext,cn3927.yaml
 create mode 100644 Documentation/devicetree/bindings/media/i2c/smartsens,sc1300cs.yaml
 create mode 100644 Documentation/devicetree/bindings/media/i2c/smartsens,sc820cs.yaml

diff --git a/Documentation/devicetree/bindings/media/i2c/chipnext,cn3927.yaml b/Documentation/devicetree/bindings/media/i2c/chipnext,cn3927.yaml
new file mode 100644
index 000000000..710aebfaf
--- /dev/null
+++ b/Documentation/devicetree/bindings/media/i2c/chipnext,cn3927.yaml
@@ -0,0 +1,48 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/media/i2c/chipnext,cn3927.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Chipnext CN3927 voice coil lens actuator
+
+maintainers:
+  - Erwin <46088090+yzddmr6@users.noreply.github.com>
+
+description:
+  The CN3927 controls a camera lens voice coil through a 10-bit DAC
+  and an I2C control interface.
+
+properties:
+  compatible:
+    const: chipnext,cn3927
+
+  reg:
+    maxItems: 1
+
+  vio-supply:
+    description: I/O supply, 1.8 V.
+
+  vaf-supply:
+    description: Voice coil supply, 2.8 V.
+
+required:
+  - compatible
+  - reg
+  - vio-supply
+  - vaf-supply
+
+additionalProperties: false
+
+examples:
+  - |
+    i2c {
+        #address-cells = <1>;
+        #size-cells = <0>;
+        lens@c {
+            compatible = "chipnext,cn3927";
+            reg = <0x0c>;
+            vio-supply = <&camera_vio>;
+            vaf-supply = <&camera_vaf>;
+        };
+    };
diff --git a/Documentation/devicetree/bindings/media/i2c/smartsens,sc1300cs.yaml b/Documentation/devicetree/bindings/media/i2c/smartsens,sc1300cs.yaml
new file mode 100644
index 000000000..f8d659def
--- /dev/null
+++ b/Documentation/devicetree/bindings/media/i2c/smartsens,sc1300cs.yaml
@@ -0,0 +1,101 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/media/i2c/smartsens,sc1300cs.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: SmartSens SC1300CS 13-megapixel CMOS image sensor
+
+maintainers:
+  - Erwin <46088090+yzddmr6@users.noreply.github.com>
+
+description:
+  The SC1300CS is a RAW image sensor with an I2C control interface
+  and a MIPI CSI-2 output. The supported configuration uses four D-PHY
+  data lanes and a 24 MHz input clock.
+
+allOf:
+  - $ref: /schemas/media/video-interface-devices.yaml#
+
+properties:
+  compatible:
+    const: smartsens,sc1300cs
+
+  reg:
+    maxItems: 1
+
+  clocks:
+    maxItems: 1
+
+  avdd-supply:
+    description: Analogue supply, 2.8 V.
+
+  dvdd-supply:
+    description: Digital core supply, 1.2 V.
+
+  dovdd-supply:
+    description: Digital I/O supply, 1.8 V.
+
+  reset-gpios:
+    description: Active-low reset signal.
+    maxItems: 1
+
+  port:
+    $ref: /schemas/graph.yaml#/$defs/port-base
+    additionalProperties: false
+    properties:
+      endpoint:
+        $ref: /schemas/media/video-interfaces.yaml#
+        unevaluatedProperties: false
+        properties:
+          data-lanes:
+            items:
+              - const: 1
+              - const: 2
+              - const: 3
+              - const: 4
+          link-frequencies:
+            maxItems: 1
+        required:
+          - data-lanes
+          - link-frequencies
+
+required:
+  - compatible
+  - reg
+  - clocks
+  - avdd-supply
+  - dvdd-supply
+  - dovdd-supply
+  - reset-gpios
+  - port
+
+unevaluatedProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/gpio/gpio.h>
+
+    i2c {
+        #address-cells = <1>;
+        #size-cells = <0>;
+
+        camera@36 {
+            compatible = "smartsens,sc1300cs";
+            reg = <0x36>;
+            clocks = <&camera_clk>;
+            assigned-clocks = <&camera_clk>;
+            assigned-clock-rates = <24000000>;
+            avdd-supply = <&camera_avdd>;
+            dvdd-supply = <&camera_dvdd>;
+            dovdd-supply = <&camera_dovdd>;
+            reset-gpios = <&gpio 7 GPIO_ACTIVE_LOW>;
+            port {
+                endpoint {
+                    remote-endpoint = <&csi_in>;
+                    data-lanes = <1 2 3 4>;
+                    link-frequencies = /bits/ 64 <600000000>;
+                };
+            };
+        };
+    };
