From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Colin <colin@opd2413>
Date: Wed, 25 Nov 2026 22:47:00 +0800
Subject: [PATCH] drm/msm/dp: sync downshifted link caps, adjust bpp, and renegotiate oversized modes

When msm_dp_ctrl_on_link() succeeds after downshifting the link rate or
lane count (for example, 2-lane HBR3 810000 -> HBR2 540000 on a USB-C
HDMI dock), panel->link_info still advertised the higher DPCD rate.
As a result:

- Modes whose required bandwidth exceeds the trained link (e.g.
  3840x2160@60 at 18 bpp = 10.69 Gbps over an 8.64 Gbps 2-lane HBR2
  link) were driven anyway, overflowing the DP transfer unit and causing
  severe distortion, horizontal wrapping, and jitter.
- Modes that still fit at lower color depth (e.g. 3840x2160@30 at 24 bpp
  = 7.13 Gbps) were still configured at 30 bpp (8.91 Gbps > 8.64 Gbps),
  corrupting the right edge of the display.

Sync panel->link_info.{rate,num_lanes} to the trained link parameters on
downshift, recompute the mode bpp against the real link bandwidth (and
reprogram REG_DP_CONFIGURATION_CTRL before stream start), and schedule
an asynchronous DRM_MODE_LINK_STATUS_BAD + connector hotplug event
whenever link training fails or the current mode exceeds the trained
bandwidth so userspace reprobes valid modes and switches cleanly.

Co-Authored-By: Antigravity <noreply@google.com>
---
--- a/drivers/gpu/drm/msm/dp/dp_ctrl.c
+++ b/drivers/gpu/drm/msm/dp/dp_ctrl.c
@@ -2563,6 +2563,8 @@
 	 */
 	reinit_completion(&ctrl->video_comp);
 
+	msm_dp_ctrl_config_ctrl(ctrl);
+
 	msm_dp_ctrl_configure_source_params(ctrl);
 
 	msm_dp_ctrl_config_msa(ctrl,
--- a/drivers/gpu/drm/msm/dp/dp_display.c
+++ b/drivers/gpu/drm/msm/dp/dp_display.c
@@ -15,6 +15,7 @@
 #include <drm/display/drm_dp_aux_bus.h>
 #include <drm/display/drm_hdmi_audio_helper.h>
 #include <drm/drm_edid.h>
+#include <drm/drm_probe_helper.h>
 
 #include "msm_drv.h"
 #include "msm_kms.h"
@@ -81,6 +82,7 @@
 	/* HPD IRQ handling */
 	spinlock_t irq_thread_lock;
 	u32 hpd_isr_status;
+	struct work_struct link_status_work;
 
 	bool wide_bus_supported;
 
@@ -212,6 +214,19 @@
 	complete_all(&dp->audio_comp);
 }
 
+static void msm_dp_display_link_status_work(struct work_struct *work)
+{
+	struct msm_dp_display_private *dp =
+		container_of(work, struct msm_dp_display_private, link_status_work);
+	struct drm_connector *connector = dp->msm_dp_display.connector;
+
+	if (!connector || !dp->drm_dev)
+		return;
+
+	drm_connector_set_link_status_property(connector, DRM_MODE_LINK_STATUS_BAD);
+	drm_kms_helper_connector_hotplug_event(connector);
+}
+
 static int msm_dp_display_bind(struct device *dev, struct device *master,
 			   void *data)
 {
@@ -1202,6 +1217,7 @@
 	dp->hpd_isr_status = 0;
 
 	mutex_init(&dp->plugged_lock);
+	INIT_WORK(&dp->link_status_work, msm_dp_display_link_status_work);
 
 	rc = msm_dp_display_get_io(dp);
 	if (rc)
@@ -1261,6 +1277,7 @@
 {
 	struct msm_dp_display_private *dp = dev_get_dp_display_private(&pdev->dev);
 
+	cancel_work_sync(&dp->link_status_work);
 	component_del(&pdev->dev, &msm_dp_display_comp_ops);
 	msm_dp_display_deinit_sub_modules(dp);
 	platform_set_drvdata(pdev, NULL);
@@ -1437,10 +1454,36 @@
 	rc = msm_dp_ctrl_on_link(msm_dp_display->ctrl);
 	if (rc) {
 		DRM_ERROR("Failed link training (rc=%d)\n", rc);
-		// TODO: schedule drm_connector_set_link_status_property()
+		if (!dp->is_edp)
+			schedule_work(&msm_dp_display->link_status_work);
 		return;
 	}
 
+	if (msm_dp_display->link->link_params.rate < msm_dp_display->panel->link_info.rate ||
+	    msm_dp_display->link->link_params.num_lanes < msm_dp_display->panel->link_info.num_lanes) {
+		struct msm_dp_panel *panel = msm_dp_display->panel;
+		u32 link_pclk_khz = panel->msm_dp_mode.drm_mode.clock;
+		u32 supported_rate_khz;
+		u32 mode_bpp;
+
+		panel->link_info.rate = msm_dp_display->link->link_params.rate;
+		panel->link_info.num_lanes = msm_dp_display->link->link_params.num_lanes;
+		supported_rate_khz = panel->link_info.num_lanes * panel->link_info.rate * 8;
+
+		if (panel->msm_dp_mode.out_fmt_is_yuv_420)
+			link_pclk_khz /= 2;
+
+		mode_bpp = msm_dp_panel_get_mode_bpp(panel, panel->msm_dp_mode.bpp,
+						     link_pclk_khz);
+		if (link_pclk_khz * mode_bpp > supported_rate_khz) {
+			if (!dp->is_edp)
+				schedule_work(&msm_dp_display->link_status_work);
+		} else {
+			panel->msm_dp_mode.bpp = mode_bpp;
+			msm_dp_display->msm_dp_mode.bpp = mode_bpp;
+		}
+	}
+
 	msm_dp_display_enable(msm_dp_display, force_link_train);
 
 	rc = msm_dp_display_post_enable(dp);
