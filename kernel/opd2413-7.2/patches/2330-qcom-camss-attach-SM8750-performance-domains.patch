From e4d86527f0dd4469dd8c1b7f962c2db1380f1539 Mon Sep 17 00:00:00 2001
From: yzddmr6 <46088090+yzddmr6@users.noreply.github.com>
Date: Thu, 1 Oct 2026 06:50:39 +0800
Subject: [PATCH] media: qcom: camss: attach SM8750 performance domains

Attach the SM8750 performance suppliers by name before configuring the GDSCs. Use runtime PM device links and devres cleanup so the DT-required performance states follow CAMSS users and are released when idle or on probe failure.

Do not activate suppliers at attachment time or attach the individually managed VFE domains through this list. Existing platforms keep their current domain handling.

Assisted-by: LLM
Co-Authored-By: Claude Fable 5.1 <noreply@anthropic.com>
---
 drivers/media/platform/qcom/camss/camss.c | 23 +++++++++++++++++++++++
 drivers/media/platform/qcom/camss/camss.h |  1 +
 2 files changed, 24 insertions(+)

diff --git a/drivers/media/platform/qcom/camss/camss.c b/drivers/media/platform/qcom/camss/camss.c
index a2b3c418a..719cc7def 100644
--- a/drivers/media/platform/qcom/camss/camss.c
+++ b/drivers/media/platform/qcom/camss/camss.c
@@ -5694,6 +5694,17 @@ static const struct media_device_ops camss_media_ops = {
 	.link_notify = v4l2_pipeline_link_notify,
 };
 
+static int camss_configure_perf_domains(struct camss *camss)
+{
+	struct dev_pm_domain_list *pd_list;
+
+	if (!camss->res->perf_domains)
+		return 0;
+
+	return devm_pm_domain_attach_list(camss->dev, camss->res->perf_domains,
+					 &pd_list);
+}
+
 static int camss_configure_pd(struct camss *camss)
 {
 	const struct camss_resources *res = camss->res;
@@ -5868,6 +5879,10 @@ static int camss_probe(struct platform_device *pdev)
 	if (ret < 0)
 		return ret;
 
+	ret = camss_configure_perf_domains(camss);
+	if (ret < 0)
+		return dev_err_probe(dev, ret, "Failed to attach performance domains\n");
+
 	ret = camss_configure_pd(camss);
 	if (ret < 0) {
 		dev_err(dev, "Failed to configure power domains: %d\n", ret);
@@ -6203,8 +6218,16 @@ static const struct camss_resources sm8650_resources = {
 	.vfe_num = ARRAY_SIZE(vfe_res_sm8650),
 };
 
+static const char * const sm8750_perf_domain_names[] = { "mmcx", "mx", "mxc" };
+
+static const struct dev_pm_domain_attach_data sm8750_perf_domains = {
+	.pd_names = sm8750_perf_domain_names,
+	.num_pd_names = ARRAY_SIZE(sm8750_perf_domain_names),
+};
+
 static const struct camss_resources sm8750_resources = {
 	.version = CAMSS_8750,
+	.perf_domains = &sm8750_perf_domains,
 	.pd_name = "top",
 	.csiphy_res = csiphy_res_kaanapali,
 	.tpg_res = tpg_res_x1e80100,
diff --git a/drivers/media/platform/qcom/camss/camss.h b/drivers/media/platform/qcom/camss/camss.h
index 3511e95bc..516153e1c 100644
--- a/drivers/media/platform/qcom/camss/camss.h
+++ b/drivers/media/platform/qcom/camss/camss.h
@@ -109,6 +109,7 @@ enum icc_count {
 struct camss_resources {
 	enum camss_version version;
 	const char *pd_name;
+	const struct dev_pm_domain_attach_data *perf_domains;
 	const struct camss_subdev_resources *csiphy_res;
 	const struct camss_subdev_resources *tpg_res;
 	const struct camss_subdev_resources *csid_res;
