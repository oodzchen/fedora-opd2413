+					USB_OPLUS_OTG_AP_ENABLE, 1);
+	if (!ret)
+		ret = qcom_battmgr_set_property(battmgr, BATTMGR_USB_PROPERTY_SET,
+						USB_OPLUS_OTG_SWITCH, 1);
+	if (ret)
+		dev_err(battmgr->dev, "failed to enable USB source mode: %d\n", ret);
+}
