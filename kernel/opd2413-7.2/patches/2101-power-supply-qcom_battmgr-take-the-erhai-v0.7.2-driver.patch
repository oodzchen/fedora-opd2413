+static bool qcom_battmgr_charge_limited(struct qcom_battmgr *battmgr)
+{
+	unsigned int end = READ_ONCE(battmgr->info.charge_ctrl_end);
+
+	return end && end < CHARGE_CTRL_END_THR_MAX;
