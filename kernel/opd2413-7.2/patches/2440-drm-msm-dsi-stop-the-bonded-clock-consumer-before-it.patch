From ff1a1513c1150000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: yzddmr6 <46088090+yzddmr6@users.noreply.github.com>
Date: Mon, 12 Oct 2026 04:56:54 +0000
Subject: [PATCH] drm/msm/dsi: stop the bonded clock consumer before its source

In bonded mode host 1 consumes the clocks supplied by PHY 0. Powering
host 0 off first can remove that source while host 1 is still disabling
its link clocks, leaving the latter's clock branches stuck on.

Power off host 1 before host 0, matching the existing power-on error
unwind. Keep PLL state saving before either host shuts down and disable
both PHYs after both hosts have stopped.

Fixes: a689554ba6ed ("drm/msm: Initial add DSI connector support")

(cherry picked from commit 608ff1b238a0c5dbbfe0f36cc73ce9dd48395c66)

Co-Authored-By: Claude Fable 5.1 <noreply@anthropic.com>
[Refreshed against Linux 7.2.15 dsi_mgr_bridge_post_disable() signature]
---
 drivers/gpu/drm/msm/dsi/dsi_manager.c | 11 ++++++-----
 1 file changed, 6 insertions(+), 5 deletions(-)

diff --git a/drivers/gpu/drm/msm/dsi/dsi_manager.c b/drivers/gpu/drm/msm/dsi/dsi_manager.c
index 1a2b3c4d5..2b3c4d5e6 100644
--- a/drivers/gpu/drm/msm/dsi/dsi_manager.c
+++ b/drivers/gpu/drm/msm/dsi/dsi_manager.c
@@ -376,17 +376,18 @@ static void dsi_mgr_bridge_post_disable(struct drm_bridge *bridge)
 	/* Save PHY status if it is a clock source */
 	msm_dsi_phy_pll_save_state(msm_dsi->phy);
 
-	ret = msm_dsi_host_power_off(host);
-	if (ret)
-		pr_err("%s: host %d power off failed,%d\n", __func__, id, ret);
-
+	/* Stop the external-clock consumer before its clock-source host. */
 	if (is_bonded_dsi && msm_dsi1) {
 		ret = msm_dsi_host_power_off(msm_dsi1->host);
 		if (ret)
 			pr_err("%s: host1 power off failed, %d\n",
 								__func__, ret);
 	}
 
+	ret = msm_dsi_host_power_off(host);
+	if (ret)
+		pr_err("%s: host %d power off failed,%d\n", __func__, id, ret);
+
 disable_phy:
 	dsi_mgr_phy_disable(id);
 }
