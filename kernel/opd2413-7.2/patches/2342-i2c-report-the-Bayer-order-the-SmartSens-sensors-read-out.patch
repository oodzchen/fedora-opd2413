From 70b88076cbdd26dbfd0d3edae5b8a2156d738d5a Mon Sep 17 00:00:00 2001
From: yzddmr6 <46088090+yzddmr6@users.noreply.github.com>
Date: Fri, 30 Oct 2026 23:59:56 +0800
Subject: [PATCH] media: i2c: report the Bayer order the SmartSens sensors read
 out

Both sensors carry an RGGB colour filter array. The front SC820CS runs
without mirror or flip and therefore reads out RGGB. The rear SC1300CS
runs with both mirror and flip set (0x3221 = 0x66), which turns the
readout into BGGR. The drivers advertised the swapped orders, so an ISP
exchanged red and blue.

RAW measurements on this hardware reached the same orders independently.

Link: https://github.com/TheMojoMan/oneplus-erhai-linux/issues/5
Link: https://github.com/yzddmr6/onepluspad-2pro-mainline/issues/12
Assisted-by: LLM
Co-Authored-By: Claude Fable 5.1 <noreply@anthropic.com>
---
 drivers/media/i2c/sc1300cs.c | 8 ++++----
 drivers/media/i2c/sc820cs.c  | 8 ++++----
 2 files changed, 8 insertions(+), 8 deletions(-)

diff --git a/drivers/media/i2c/sc1300cs.c b/drivers/media/i2c/sc1300cs.c
index 21423e88c..b090a90a2 100644
--- a/drivers/media/i2c/sc1300cs.c
+++ b/drivers/media/i2c/sc1300cs.c
@@ -243,7 +243,7 @@ static const struct cci_reg_sequence sc1300cs_mode[] = {
 	{ CCI_REG8(0x3213), 0x08 },
 	{ CCI_REG8(0x3215), 0x11 },
 	{ CCI_REG8(0x3220), 0x00 },
-	/* Both flips: the captured mode starts with an RGGB pixel. */
+	/* Both flips: mirrored and flipped, the RGGB array reads out as BGGR. */
 	{ CCI_REG8(0x3221), 0x66 },
 	{ CCI_REG8(0x5000), 0x1e },
 	{ CCI_REG8(0x5900), 0x01 },
@@ -463,7 +463,7 @@ static int sc1300cs_set_format(struct v4l2_subdev *sd,
 	fmt->format = (struct v4l2_mbus_framefmt) {
 		.width = SC1300CS_WIDTH,
 		.height = SC1300CS_HEIGHT,
-		.code = MEDIA_BUS_FMT_SRGGB10_1X10,
+		.code = MEDIA_BUS_FMT_SBGGR10_1X10,
 		.field = V4L2_FIELD_NONE,
 		.colorspace = V4L2_COLORSPACE_RAW,
 		.ycbcr_enc = V4L2_YCBCR_ENC_DEFAULT,
@@ -492,7 +492,7 @@ static int sc1300cs_enum_mbus_code(struct v4l2_subdev *sd,
 {
 	if (code->index)
 		return -EINVAL;
-	code->code = MEDIA_BUS_FMT_SRGGB10_1X10;
+	code->code = MEDIA_BUS_FMT_SBGGR10_1X10;
 	return 0;
 }
 
@@ -500,7 +500,7 @@ static int sc1300cs_enum_frame_size(struct v4l2_subdev *sd,
 				  struct v4l2_subdev_state *state,
 				  struct v4l2_subdev_frame_size_enum *fse)
 {
-	if (fse->index || fse->code != MEDIA_BUS_FMT_SRGGB10_1X10)
+	if (fse->index || fse->code != MEDIA_BUS_FMT_SBGGR10_1X10)
 		return -EINVAL;
 	fse->min_width = fse->max_width = SC1300CS_WIDTH;
 	fse->min_height = fse->max_height = SC1300CS_HEIGHT;
diff --git a/drivers/media/i2c/sc820cs.c b/drivers/media/i2c/sc820cs.c
index ef03e01b2..c2ac69c81 100644
--- a/drivers/media/i2c/sc820cs.c
+++ b/drivers/media/i2c/sc820cs.c
@@ -194,7 +194,7 @@ static const struct cci_reg_sequence sc820cs_mode[] = {
 	{ CCI_REG8(0x5780), 0x66 },
 	{ CCI_REG8(0x578d), 0x40 },
 	{ CCI_REG8(0x57aa), 0xeb },
-	/* No flips: keep the BGGR phase advertised on the source pad. */
+	/* No flips: the readout starts with the R pixel of the RGGB array. */
 	{ CCI_REG8(0x3221), 0x00 },
 	{ CCI_REG8(0x301f), 0x0e },
 	{ CCI_REG8(0x3200), 0x00 },
@@ -431,7 +431,7 @@ static int sc820cs_set_format(struct v4l2_subdev *sd,
 	fmt->format = (struct v4l2_mbus_framefmt) {
 		.width = SC820CS_WIDTH,
 		.height = SC820CS_HEIGHT,
-		.code = MEDIA_BUS_FMT_SBGGR10_1X10,
+		.code = MEDIA_BUS_FMT_SRGGB10_1X10,
 		.field = V4L2_FIELD_NONE,
 		.colorspace = V4L2_COLORSPACE_RAW,
 		.ycbcr_enc = V4L2_YCBCR_ENC_DEFAULT,
@@ -460,7 +460,7 @@ static int sc820cs_enum_mbus_code(struct v4l2_subdev *sd,
 {
 	if (code->index)
 		return -EINVAL;
-	code->code = MEDIA_BUS_FMT_SBGGR10_1X10;
+	code->code = MEDIA_BUS_FMT_SRGGB10_1X10;
 	return 0;
 }
 
@@ -468,7 +468,7 @@ static int sc820cs_enum_frame_size(struct v4l2_subdev *sd,
 				  struct v4l2_subdev_state *state,
 				  struct v4l2_subdev_frame_size_enum *fse)
 {
-	if (fse->index || fse->code != MEDIA_BUS_FMT_SBGGR10_1X10)
+	if (fse->index || fse->code != MEDIA_BUS_FMT_SRGGB10_1X10)
 		return -EINVAL;
 	fse->min_width = fse->max_width = SC820CS_WIDTH;
 	fse->min_height = fse->max_height = SC820CS_HEIGHT;
