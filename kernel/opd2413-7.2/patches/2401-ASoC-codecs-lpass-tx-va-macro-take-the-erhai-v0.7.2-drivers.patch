+	SOC_ENUM("TX4 HPF cut off", hpf_cut_off_enum[4]),
+	SOC_ENUM("TX5 HPF cut off", hpf_cut_off_enum[5]),
+	SOC_ENUM("TX6 HPF cut off", hpf_cut_off_enum[6]),
