@@ -2053,6 +2130,15 @@ static const struct snd_kcontrol_new tx_macro_snd_controls[] = {
 	SOC_ENUM_EXT("DEC7 MODE", dec_mode_mux_enum[7],
 			tx_macro_dec_mode_get, tx_macro_dec_mode_put),
 
