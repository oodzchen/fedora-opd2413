From 037387b1016891d534f66f16be7a8969361fa2e1 Mon Sep 17 00:00:00 2001
From: Kholin <oodzchen@gmail.com>
Date: Fri, 13 Nov 2026 17:03:56 +0800
Subject: [PATCH] Input: oneplus-pogo-keyboard - wake from suspend on key press

Arm an optional falling-edge "wakeup" GPIO interrupt (IRQF_NO_SUSPEND | IRQF_NO_AUTOEN) on the shared UART RX line in suspend_noirq whenever a keyboard is connected and wakeup is enabled, and disarm it in resume_noirq.

On the OPD2413 pogo keyboard, the MCU emits periodic non-key falling edges while asleep: an initial TX shutoff (~173 ms), a 10.001 s keepalive pulse (1 cluster), and a 22.659 s battery report pair (~13.3 ms apart, 2 clusters). Because the 10.001 s and 22.659 s periods beat against each other every ~1-2 minutes, their worst-case overlap yields 3 clusters. Require at least 4 falling-edge clusters (>= 4 ms apart, <= 120 ms gap) within 300 ms using the always-on arch timer counter before calling pm_wakeup_dev_event().

Co-Authored-By: Antigravity <noreply@deepmind.google>
---
 .../input/keyboard/oneplus-pogo-keyboard.c    | 160 +++++++++++++++++-
 1 file changed, 159 insertions(+), 1 deletion(-)

diff --git a/drivers/input/keyboard/oneplus-pogo-keyboard.c b/drivers/input/keyboard/oneplus-pogo-keyboard.c
index eb32be658..00d7b65e1 100644
--- a/drivers/input/keyboard/oneplus-pogo-keyboard.c
+++ b/drivers/input/keyboard/oneplus-pogo-keyboard.c
@@ -26,6 +26,7 @@
  * table is the one of usbkbd.c with that driver's four additions.
  */
 
+#include <asm/arch_timer.h>
 #include <linux/bits.h>
 #include <linux/completion.h>
 #include <linux/delay.h>
@@ -35,6 +36,7 @@
 #include <linux/input/mt.h>
 #include <linux/interrupt.h>
 #include <linux/jiffies.h>
+#include <linux/math64.h>
 #include <linux/mod_devicetable.h>
 #include <linux/module.h>
 #include <linux/mutex.h>
@@ -45,6 +47,7 @@
 #include <linux/serdev.h>
 #include <linux/spinlock.h>
 #include <linux/string.h>
+#include <linux/time64.h>
 #include <linux/unaligned.h>
 #include <linux/workqueue.h>
 
@@ -283,8 +286,34 @@ struct pogo_kb {
 	struct completion reply_done;
 
 	u16 keymap[ARRAY_SIZE(pogo_kb_hid_keys)];
+
+	/* Suspend wake-up on the shared UART RX GPIO line */
+	int rx_irq;
+	spinlock_t wake_lock;
+	bool rx_irq_active;
+	bool rx_irq_wake;
+	bool rx_irq_disabled_in_isr;
+	u32 timer_freq;
+	u64 sleep_cnt;
+	u64 wake_win_start_us;
+	u64 wake_last_cluster_us;
+	unsigned int wake_clusters;
 };
 
+/*
+ * Filter keyboard UART RX falling edges during s2idle so periodic keyboard
+ * MCU keepalive and status pulses do not cause spurious wakes:
+ * - initial TX shutoff (~173 ms into sleep): 1 cluster
+ * - 10.001 s periodic wake pulse: 1 isolated cluster
+ * - 22.659 s battery report + TX shutoff (~13.3 ms apart): 2 clusters
+ * - worst-case overlap of a 10 s pulse and battery pair: 3 clusters
+ * - real key press: >= 4 clusters within 300 ms (>= 4 ms apart, <= 120 ms gap)
+ */
+#define POGO_KB_WAKE_CLUSTER_MIN_US	4000ULL
+#define POGO_KB_WAKE_CLUSTER_MAX_US	120000ULL
+#define POGO_KB_WAKE_WINDOW_US		300000ULL
+#define POGO_KB_WAKE_CLUSTERS		4U
+
 static u16 pogo_kb_crc16(const u8 *buf, size_t len)
 {
 	u16 crc = POGO_KB_CRC_INIT;
@@ -1145,6 +1174,70 @@ static irqreturn_t pogo_kb_detect_irq(int irq, void *data)
 	return IRQ_HANDLED;
 }
 
+static irqreturn_t pogo_kb_rx_wake_isr(int irq, void *data)
+{
+	struct pogo_kb *kb = data;
+	u64 now = arch_timer_read_counter();
+	u64 now_us = mul_u64_u32_div(now - kb->sleep_cnt, USEC_PER_SEC,
+				     kb->timer_freq);
+	unsigned long flags;
+	bool wake = false;
+
+	spin_lock_irqsave(&kb->wake_lock, flags);
+	if (!kb->rx_irq_active) {
+		spin_unlock_irqrestore(&kb->wake_lock, flags);
+		return IRQ_NONE;
+	}
+
+	if (!kb->wake_clusters ||
+	    now_us - kb->wake_last_cluster_us > POGO_KB_WAKE_CLUSTER_MAX_US ||
+	    now_us - kb->wake_win_start_us > POGO_KB_WAKE_WINDOW_US) {
+		kb->wake_win_start_us = now_us;
+		kb->wake_last_cluster_us = now_us;
+		kb->wake_clusters = 1;
+	} else if (now_us - kb->wake_last_cluster_us >= POGO_KB_WAKE_CLUSTER_MIN_US) {
+		kb->wake_last_cluster_us = now_us;
+		if (++kb->wake_clusters >= POGO_KB_WAKE_CLUSTERS) {
+			kb->rx_irq_active = false;
+			kb->rx_irq_disabled_in_isr = true;
+			disable_irq_nosync(irq);
+			wake = true;
+		}
+	}
+	spin_unlock_irqrestore(&kb->wake_lock, flags);
+
+	if (wake)
+		pm_wakeup_dev_event(kb->dev, 0, true);
+
+	return IRQ_HANDLED;
+}
+
+static void pogo_kb_disarm_rx_irq(struct pogo_kb *kb)
+{
+	unsigned long flags;
+	bool need_disable = false;
+	bool had_isr_disable = false;
+
+	if (kb->rx_irq <= 0)
+		return;
+
+	spin_lock_irqsave(&kb->wake_lock, flags);
+	if (kb->rx_irq_active) {
+		kb->rx_irq_active = false;
+		need_disable = true;
+	}
+	if (kb->rx_irq_disabled_in_isr) {
+		kb->rx_irq_disabled_in_isr = false;
+		had_isr_disable = true;
+	}
+	spin_unlock_irqrestore(&kb->wake_lock, flags);
+
+	if (need_disable)
+		disable_irq(kb->rx_irq);
+	else if (had_isr_disable)
+		synchronize_irq(kb->rx_irq);
+}
+
 static int pogo_kb_probe(struct serdev_device *serdev)
 {
 	struct device *dev = &serdev->dev;
@@ -1159,7 +1252,9 @@ static int pogo_kb_probe(struct serdev_device *serdev)
 	kb->serdev = serdev;
 	kb->dev = dev;
 	kb->state = POGO_KB_IDLE;
+	kb->timer_freq = arch_timer_get_cntfrq();
 	spin_lock_init(&kb->rx_lock);
+	spin_lock_init(&kb->wake_lock);
 	init_completion(&kb->echo_done);
 	init_completion(&kb->reply_done);
 	INIT_DELAYED_WORK(&kb->poll_work, pogo_kb_poll_work);
@@ -1209,6 +1304,24 @@ static int pogo_kb_probe(struct serdev_device *serdev)
 	if (ret)
 		return dev_err_probe(dev, ret, "failed to request the sense interrupt\n");
 
+	kb->rx_irq = fwnode_irq_get_byname(dev_fwnode(dev), "wakeup");
+	if (kb->rx_irq == -EPROBE_DEFER)
+		return kb->rx_irq;
+	if (kb->rx_irq > 0 && kb->timer_freq) {
+		ret = devm_request_irq(dev, kb->rx_irq, pogo_kb_rx_wake_isr,
+				       IRQF_NO_SUSPEND | IRQF_NO_AUTOEN,
+				       "pogo-keyboard-wakeup", kb);
+		if (ret)
+			return dev_err_probe(dev, ret,
+					     "failed to request the wake interrupt\n");
+	} else if (kb->rx_irq < 0 && kb->rx_irq != -EINVAL &&
+		   kb->rx_irq != -ENODATA && kb->rx_irq != -ENOENT) {
+		return dev_err_probe(dev, kb->rx_irq,
+				     "failed to get the wake interrupt\n");
+	} else {
+		kb->rx_irq = 0;
+	}
+
 	if (device_property_read_bool(dev, "wakeup-source")) {
 		ret = devm_device_init_wakeup(dev);
 		if (ret)
@@ -1227,6 +1340,7 @@ static void pogo_kb_remove(struct serdev_device *serdev)
 {
 	struct pogo_kb *kb = serdev_device_get_drvdata(serdev);
 
+	pogo_kb_disarm_rx_irq(kb);
 	disable_irq(kb->irq);
 	disable_delayed_work_sync(&kb->poll_work);
 	disable_work_sync(&kb->attach_work);
@@ -1312,7 +1426,51 @@ static int pogo_kb_resume(struct device *dev)
 	return 0;
 }
 
-static DEFINE_SIMPLE_DEV_PM_OPS(pogo_kb_pm_ops, pogo_kb_suspend, pogo_kb_resume);
+static int pogo_kb_suspend_noirq(struct device *dev)
+{
+	struct pogo_kb *kb = dev_get_drvdata(dev);
+	unsigned long flags;
+
+	if (kb->state == POGO_KB_CONNECTED && kb->rx_irq > 0 &&
+	    device_may_wakeup(dev)) {
+		spin_lock_irqsave(&kb->wake_lock, flags);
+		kb->sleep_cnt = arch_timer_read_counter();
+		kb->wake_win_start_us = 0;
+		kb->wake_last_cluster_us = 0;
+		kb->wake_clusters = 0;
+		kb->rx_irq_disabled_in_isr = false;
+		kb->rx_irq_active = true;
+		spin_unlock_irqrestore(&kb->wake_lock, flags);
+
+		enable_irq(kb->rx_irq);
+		if (!enable_irq_wake(kb->rx_irq))
+			kb->rx_irq_wake = true;
+	}
+
+	return 0;
+}
+
+static int pogo_kb_resume_noirq(struct device *dev)
+{
+	struct pogo_kb *kb = dev_get_drvdata(dev);
+
+	if (kb->rx_irq <= 0)
+		return 0;
+
+	if (kb->rx_irq_wake) {
+		disable_irq_wake(kb->rx_irq);
+		kb->rx_irq_wake = false;
+	}
+
+	pogo_kb_disarm_rx_irq(kb);
+
+	return 0;
+}
+
+static const struct dev_pm_ops pogo_kb_pm_ops = {
+	SYSTEM_SLEEP_PM_OPS(pogo_kb_suspend, pogo_kb_resume)
+	NOIRQ_SYSTEM_SLEEP_PM_OPS(pogo_kb_suspend_noirq, pogo_kb_resume_noirq)
+};
 
 static const struct of_device_id pogo_kb_of_match[] = {
 	{ .compatible = "oneplus,pad2pro-pogo-keyboard" },
-- 
2.56.0

