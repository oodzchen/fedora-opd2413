From 3147ddd0d9d83c61b1cce1b5f0df285da91863de Mon Sep 17 00:00:00 2001
From: yading <187273358+BUSHIGEMENNI@users.noreply.github.com>
Date: Tue, 27 Oct 2026 10:26:12 +0800
Subject: [PATCH] media: i2c: bound SmartSens identification after reset
 release

Start MCLK before deasserting reset, then allow the sensor to settle.
Retry transport errors on chip identification at most eight times with
20 ms gaps, following the measured front-sensor bring-up. A successful
read of the wrong chip ID still fails immediately. Apply the same
bounded identification to the rear sensor; do not retry mode writes
or hide streaming failures.

Adapted from BUSHIGEMENNI/linux-sm8750-erhai commits
27e33c9787fb62eedb1553eb9a6c5f7d592a3af2 and
cf04eff3703d4034ff077ca7f60194ce4b739322.

Link: https://github.com/yzddmr6/onepluspad-2pro-mainline/issues/12
Assisted-by: LLM
Co-Authored-By: Claude Fable 5.1 <noreply@anthropic.com>
---
 drivers/media/i2c/sc1300cs.c | 22 +++++++++++++---------
 drivers/media/i2c/sc820cs.c  | 22 +++++++++++++---------
 2 files changed, 26 insertions(+), 18 deletions(-)

diff --git a/drivers/media/i2c/sc1300cs.c b/drivers/media/i2c/sc1300cs.c
index d989c894a..12b25bfb1 100644
--- a/drivers/media/i2c/sc1300cs.c
+++ b/drivers/media/i2c/sc1300cs.c
@@ -275,19 +275,16 @@ static int sc1300cs_power_on(struct device *dev)
 		usleep_range(1000, 1500);
 	}
 
-	/* The reset pin is active low: deassert it before starting MCLK. */
-	gpiod_set_value_cansleep(sensor->reset, 0);
-	usleep_range(1000, 1500);
+	/* Keep reset asserted until the input clock is running. */
 	ret = clk_prepare_enable(sensor->xclk);
 	if (ret)
-		goto assert_reset;
-	usleep_range(5000, 5500);
+		goto disable_supplies;
+	usleep_range(1000, 1500);
+	gpiod_set_value_cansleep(sensor->reset, 0);
+	usleep_range(10000, 12000);
 
 	return 0;
 
-assert_reset:
-	gpiod_set_value_cansleep(sensor->reset, 1);
-	usleep_range(1000, 1500);
 disable_supplies:
 	while (i--) {
 		regulator_disable(sensor->supplies[i].consumer);
@@ -603,7 +600,14 @@ static int sc1300cs_probe(struct i2c_client *client)
 	ret = sc1300cs_power_on(dev);
 	if (ret)
 		return ret;
-	ret = cci_read(sensor->regmap, CCI_REG16(0x3107), &id, NULL);
+	/* The sensor may NACK while leaving reset; bound the readiness wait. */
+	for (i = 0; i < 8; i++) {
+		ret = cci_read(sensor->regmap, CCI_REG16(0x3107), &id, NULL);
+		if (!ret)
+			break;
+		if (i < 7)
+			msleep(20);
+	}
 	if (ret)
 		goto power_off;
 	if (id != SC1300CS_CHIP_ID) {
diff --git a/drivers/media/i2c/sc820cs.c b/drivers/media/i2c/sc820cs.c
index cb1d45547..04063a333 100644
--- a/drivers/media/i2c/sc820cs.c
+++ b/drivers/media/i2c/sc820cs.c
@@ -243,19 +243,16 @@ static int sc820cs_power_on(struct device *dev)
 		usleep_range(1000, 1500);
 	}
 
-	/* The reset pin is active low: deassert it before starting MCLK. */
-	gpiod_set_value_cansleep(sensor->reset, 0);
-	usleep_range(1000, 1500);
+	/* Keep reset asserted until the input clock is running. */
 	ret = clk_prepare_enable(sensor->xclk);
 	if (ret)
-		goto assert_reset;
-	usleep_range(5000, 5500);
+		goto disable_supplies;
+	usleep_range(1000, 1500);
+	gpiod_set_value_cansleep(sensor->reset, 0);
+	usleep_range(10000, 12000);
 
 	return 0;
 
-assert_reset:
-	gpiod_set_value_cansleep(sensor->reset, 1);
-	usleep_range(1000, 1500);
 disable_supplies:
 	while (i--) {
 		regulator_disable(sensor->supplies[i].consumer);
@@ -571,7 +568,14 @@ static int sc820cs_probe(struct i2c_client *client)
 	ret = sc820cs_power_on(dev);
 	if (ret)
 		return ret;
-	ret = cci_read(sensor->regmap, CCI_REG16(0x3107), &id, NULL);
+	/* The sensor may NACK while leaving reset; bound the readiness wait. */
+	for (i = 0; i < 8; i++) {
+		ret = cci_read(sensor->regmap, CCI_REG16(0x3107), &id, NULL);
+		if (!ret)
+			break;
+		if (i < 7)
+			msleep(20);
+	}
 	if (ret)
 		goto power_off;
 	if (id != SC820CS_CHIP_ID) {
