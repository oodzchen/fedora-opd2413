From 5d1618e02f87176e73e10d57788259ddf778a6d6 Mon Sep 17 00:00:00 2001
From: yzddmr6 <46088090+yzddmr6@users.noreply.github.com>
Date: Tue, 3 Nov 2026 13:47:18 +0800
Subject: [PATCH] drm/msm/dp: release only the link resources that were taken

msm_dp_ctrl_enable_mainlink_clocks() now stops when the phy fails to
power on, but when the link clocks then fail to start it still returns
with the phy powered. The failure paths that follow also give back
resources that were never taken: link training gives up through
msm_dp_ctrl_deinitialize_mainlink(), which disables the link clocks and
powers the phy off whether or not the last enable got that far. The phy
core then drops a power count and a runtime PM reference it never took;
with the count below zero, every later phy_power_on() stops short of the
driver's power_on, so the next link is trained on an unpowered phy. The
clock framework warns about the unbalanced disable.

Undo the phy power-on when the link clocks fail, and make the link clock
disable and the phy power-off no-ops unless the clocks are on and the
phy is powered.

(cherry picked from commit bb5b7685c75c69792a32c142a480b9b7f634f28b)
Co-Authored-By: Claude Fable 5.1 <noreply@anthropic.com>
Assisted-by: LLM
---
 drivers/gpu/drm/msm/dp/dp_ctrl.c | 34 ++++++++++++++++++++------------
 1 file changed, 21 insertions(+), 13 deletions(-)

diff --git a/drivers/gpu/drm/msm/dp/dp_ctrl.c b/drivers/gpu/drm/msm/dp/dp_ctrl.c
index 6dde73c12..8b16b7cda 100644
--- a/drivers/gpu/drm/msm/dp/dp_ctrl.c
+++ b/drivers/gpu/drm/msm/dp/dp_ctrl.c
@@ -1780,6 +1780,9 @@ static void msm_dp_ctrl_link_clk_disable(struct msm_dp_ctrl *msm_dp_ctrl)
 
 	ctrl = container_of(msm_dp_ctrl, struct msm_dp_ctrl_private, msm_dp_ctrl);
 
+	if (!ctrl->link_clks_on)
+		return;
+
 	clk_bulk_disable_unprepare(ctrl->num_link_clks, ctrl->link_clks);
 
 	ctrl->link_clks_on = false;
@@ -1791,6 +1794,15 @@ static void msm_dp_ctrl_link_clk_disable(struct msm_dp_ctrl *msm_dp_ctrl)
 		   str_on_off(ctrl->core_clks_on));
 }
 
+static void msm_dp_ctrl_phy_power_off(struct msm_dp_ctrl_private *ctrl)
+{
+	if (!ctrl->phy_powered)
+		return;
+
+	phy_power_off(ctrl->phy);
+	ctrl->phy_powered = false;
+}
+
 static int msm_dp_ctrl_enable_mainlink_clocks(struct msm_dp_ctrl_private *ctrl)
 {
 	int ret = 0;
@@ -1813,8 +1825,11 @@ static int msm_dp_ctrl_enable_mainlink_clocks(struct msm_dp_ctrl_private *ctrl)
 
 	dev_pm_opp_set_rate(ctrl->dev, ctrl->link->link_params.rate * 1000);
 	ret = msm_dp_ctrl_link_clk_enable(&ctrl->msm_dp_ctrl);
-	if (ret)
+	if (ret) {
 		DRM_ERROR("Unable to start link clocks. ret=%d\n", ret);
+		msm_dp_ctrl_phy_power_off(ctrl);
+		return ret;
+	}
 
 	drm_dbg_dp(ctrl->drm_dev, "link rate=%d\n", ctrl->link->link_params.rate);
 
@@ -1954,10 +1969,7 @@ void msm_dp_ctrl_phy_exit(struct msm_dp_ctrl *msm_dp_ctrl)
 	 * that is gone, which it would act on the next time the phy is brought
 	 * up by powering on registers this exit has already unclocked.
 	 */
-	if (ctrl->phy_powered) {
-		phy_power_off(phy);
-		ctrl->phy_powered = false;
-	}
+	msm_dp_ctrl_phy_power_off(ctrl);
 
 	phy_exit(phy);
 }
@@ -1978,8 +1990,7 @@ static int msm_dp_ctrl_reinitialize_mainlink(struct msm_dp_ctrl_private *ctrl)
 	 */
 	msm_dp_ctrl_link_clk_disable(&ctrl->msm_dp_ctrl);
 
-	phy_power_off(phy);
-	ctrl->phy_powered = false;
+	msm_dp_ctrl_phy_power_off(ctrl);
 	/* hw recommended delay before re-enabling clocks */
 	msleep(20);
 
@@ -2004,8 +2015,7 @@ static int msm_dp_ctrl_deinitialize_mainlink(struct msm_dp_ctrl_private *ctrl)
 
 	msm_dp_ctrl_link_clk_disable(&ctrl->msm_dp_ctrl);
 
-	phy_power_off(phy);
-	ctrl->phy_powered = false;
+	msm_dp_ctrl_phy_power_off(ctrl);
 
 	/* aux channel down, reinit phy */
 	phy_exit(phy);
@@ -2599,8 +2609,7 @@ void msm_dp_ctrl_off_link_stream(struct msm_dp_ctrl *msm_dp_ctrl)
 	dev_pm_opp_set_rate(ctrl->dev, 0);
 	msm_dp_ctrl_link_clk_disable(&ctrl->msm_dp_ctrl);
 
-	phy_power_off(phy);
-	ctrl->phy_powered = false;
+	msm_dp_ctrl_phy_power_off(ctrl);
 
 	/* aux channel down, reinit phy */
 	phy_exit(phy);
@@ -2628,8 +2637,7 @@ void msm_dp_ctrl_off(struct msm_dp_ctrl *msm_dp_ctrl)
 
 	msm_dp_ctrl_link_clk_disable(&ctrl->msm_dp_ctrl);
 
-	phy_power_off(phy);
-	ctrl->phy_powered = false;
+	msm_dp_ctrl_phy_power_off(ctrl);
 	drm_dbg_dp(ctrl->drm_dev, "phy=%p init=%d power_on=%d\n",
 			phy, phy->init_count, phy->power_count);
 }
-- 
