From b6745e7b9ac59219268638c09f125060102c8a82 Mon Sep 17 00:00:00 2001
From: Victor Fuentes <victor@vlinkz.dev>
Date: Wed, 29 Jul 2026 19:26:08 -0700
Subject: [PATCH] drm/msm/dp: check DPCD link status return in channel_eq_ok

Check the return value of drm_dp_dpcd_read_link_status() in
msm_dp_ctrl_channel_eq_ok() so an AUX read failure returns false rather
than evaluating uninitialized stack data.

Signed-off-by: Victor Fuentes <victor@vlinkz.dev>
Source: https://github.com/infiniti-mainline/linux/commit/fd63880240ce7b119336be67fb496fea148350df

Imported from erhai (linux-sm8750-erhai commit b6745e7b9ac59219268638c09f125060102c8a82).
---
 drivers/gpu/drm/msm/dp/dp_ctrl.c | 5 ++++-
 1 file changed, 4 insertions(+), 1 deletion(-)

diff --git a/drivers/gpu/drm/msm/dp/dp_ctrl.c b/drivers/gpu/drm/msm/dp/dp_ctrl.c
index 8b16b7cda..02322a2bb 100644
--- a/drivers/gpu/drm/msm/dp/dp_ctrl.c
+++ b/drivers/gpu/drm/msm/dp/dp_ctrl.c
@@ -2256,8 +2256,11 @@ static bool msm_dp_ctrl_channel_eq_ok(struct msm_dp_ctrl_private *ctrl)
 {
 	u8 link_status[DP_LINK_STATUS_SIZE];
 	int num_lanes = ctrl->link->link_params.num_lanes;
+	int ret;
 
-	drm_dp_dpcd_read_link_status(ctrl->aux, link_status);
+	ret = drm_dp_dpcd_read_link_status(ctrl->aux, link_status);
+	if (ret)
+		return false;
 
 	return drm_dp_channel_eq_ok(link_status, num_lanes);
 }
