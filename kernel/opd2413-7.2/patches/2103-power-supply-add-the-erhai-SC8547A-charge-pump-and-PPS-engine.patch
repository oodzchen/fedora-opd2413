+static int sc8547_enable_get(void *data, u64 *val)
+{
+	struct sc8547a_device *sc = data;
+	bool en = false;
+	int ret = sc8547_get_chg_enable(sc, &en);
+
+	if (ret)
+		return ret;
+	*val = en;
+	return 0;
+}
