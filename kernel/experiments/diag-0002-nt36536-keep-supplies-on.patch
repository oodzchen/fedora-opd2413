--- out/panel-novatek-nt36536.c.kern2	2026-11-11 00:47:08.903119571 +0800
+++ out/kernel-tree/drivers/gpu/drm/panel/panel-novatek-nt36536.c	2026-11-11 01:00:47.511270979 +0800
@@ -24,6 +24,7 @@
 struct novatek_nt36536 {
 	struct drm_panel panel;
 	struct mipi_dsi_device *dsi[2];
+	bool powered;	/* EXPERIMENT diag2: supplies kept on across unprepare */
 	struct drm_dsc_config dsc;
 	struct gpio_desc *reset_gpio;
 	struct regulator *vddio;
@@ -200,6 +201,29 @@
  * KTZ8868 bias switching (OUTP, 8 ms, OUTN, 10 ms on the way up; 2 ms, OUTN,
  * 8 ms, OUTP, 10 ms on the way down).
  */
+/*
+ * DIAGNOSTIC (not for merging): read back what the panel reports on each
+ * link, to tell whether the on-commands took effect. DCS 0x0A is the power
+ * mode (0x9c = booster on, sleep out, normal mode, display on), 0x05 the DSI
+ * error count.
+ */
+static void novatek_nt36536_dump_state(struct novatek_nt36536 *ctx,
+				       const char *when)
+{
+	int i;
+
+	for (i = 0; i < 2; i++) {
+		u8 mode = 0, err = 0;
+		int r1, r2;
+
+		r1 = mipi_dsi_dcs_get_power_mode(ctx->dsi[i], &mode);
+		r2 = mipi_dsi_dcs_read(ctx->dsi[i], 0x05, &err, 1);
+		dev_info(&ctx->dsi[0]->dev,
+			 "diag %s: dsi%d power_mode=%#04x (%d) dsi_errors=%#04x (%d)\n",
+			 when, i, mode, r1, err, r2);
+	}
+}
+
 static int novatek_nt36536_power_on(struct novatek_nt36536 *ctx)
 {
 	int ret;
@@ -252,9 +276,16 @@
 	struct mipi_dsi_multi_context dsi_ctx = { .dsi = ctx->dsi[1] };
 	int ret;
 
-	ret = novatek_nt36536_power_on(ctx);
-	if (ret < 0)
-		return ret;
+	/*
+	 * EXPERIMENT diag2: after the first prepare the supplies stay on, so a
+	 * runtime re-prepare matches boot (powered panel, reset, on-commands).
+	 */
+	if (!ctx->powered) {
+		ret = novatek_nt36536_power_on(ctx);
+		if (ret < 0)
+			return ret;
+		ctx->powered = true;
+	}
 
 	novatek_nt36536_reset(ctx);
 
@@ -274,10 +305,13 @@
 		goto err;
 	}
 
+	novatek_nt36536_dump_state(ctx, "after-on");
+
 	return 0;
 
 err:
 	novatek_nt36536_power_off(ctx);
+	ctx->powered = false;
 
 	return ret;
 }
@@ -288,11 +322,14 @@
 	struct device *dev = &ctx->dsi[0]->dev;
 	int ret;
 
+	novatek_nt36536_dump_state(ctx, "before-off");
+
 	ret = novatek_nt36536_off(ctx);
 	if (ret < 0)
 		dev_err(dev, "failed to off panel: %d\n", ret);
 
-	novatek_nt36536_power_off(ctx);
+	/* EXPERIMENT diag2: display off and sleep in only; supplies stay on. */
+	dev_info(dev, "diag2: keeping panel supplies on across unprepare\n");
 
 	return 0;
 }
