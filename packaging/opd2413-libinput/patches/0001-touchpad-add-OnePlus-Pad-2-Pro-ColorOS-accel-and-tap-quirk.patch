index 0000000..57c54b8
--- /dev/null
+++ b/quirks/50-system-oneplus.quirks
@@ -0,0 +1,7 @@
+# Do not edit this file, it will be overwritten on update
+
+[OnePlus Pad 2 Pro Pogo Keyboard Touchpad]
+MatchUdevType=touchpad
+MatchVendor=0x22D9
+MatchProduct=0x3869
+ModelOnePlusOPD2413Touchpad=1
