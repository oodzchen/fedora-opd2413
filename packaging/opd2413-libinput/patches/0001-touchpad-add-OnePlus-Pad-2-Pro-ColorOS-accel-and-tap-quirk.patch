+
+static bool
+opd2413_parse_scale_in_range(const char *start, const char *stop, double *out)
+{
+	const char *p = start;
+
+	while ((p = strstr(p, "\"scale\"")) != NULL) {
+		const char *q;
+		char *end = NULL;
+		double val;
+
+		if (stop && p >= stop)
+			break;
+		q = p + 7;
+		while (*q == ' ' || *q == '\t' || *q == '\r' || *q == '\n')
+			q++;
+		if (*q != ':') {
+			p = q;
+			continue;
+		}
+		q++;
+		while (*q == ' ' || *q == '\t' || *q == '\r' || *q == '\n')
+			q++;
+		val = strtod(q, &end);
+		if (end != q && isfinite(val) && val >= 1.0 && val <= 4.0) {
+			*out = val;
+			return true;
+		}
+		p = q;
+	}
+
+	return false;
+}
+
+static double
+opd2413_detect_display_scale(void)
+{
+	const char *env = getenv("OPD2413_TOUCHPAD_SCALE");
+	const char *xdg;
+	const char *home;
+	char path[512];
+	FILE *fp;
+	char *buf;
+	size_t nread;
+	double scale = 2.5;
+	const char *dsi1;
+
+	if (env && env[0]) {
+		char *end = NULL;
+		double v = strtod(env, &end);
+		if (end != env && isfinite(v) && v >= 1.0 && v <= 4.0)
+			return v;
+	}
+
+	xdg = getenv("XDG_CONFIG_HOME");
+	home = getenv("HOME");
+	if (xdg && xdg[0]) {
+		snprintf(path, sizeof(path), "%s/kwinoutputconfig.json", xdg);
+	} else if (home && home[0]) {
+		snprintf(path, sizeof(path), "%s/.config/kwinoutputconfig.json", home);
+	} else {
+		return scale;
+	}
+
+	fp = fopen(path, "rb");
+	if (!fp)
+		return scale;
+
+	buf = calloc(1, 65537);
+	if (!buf) {
+		fclose(fp);
+		return scale;
+	}
+	nread = fread(buf, 1, 65536, fp);
+	fclose(fp);
+	if (nread == 0) {
+		free(buf);
+		return scale;
+	}
+
+	dsi1 = strstr(buf, "\"DSI-1\"");
+	if (dsi1) {
+		const char *next_conn = strstr(dsi1 + 7, "\"connectorName\"");
+		if (opd2413_parse_scale_in_range(dsi1 + 7, next_conn, &scale)) {
+			free(buf);
+			return scale;
+		}
+	}
+	opd2413_parse_scale_in_range(buf, NULL, &scale);
+	free(buf);
+	return scale;
+}
+
+static inline double
+opd2413_speed_factor(double s)
+{
+	static const int factors[15] = {
+		1, 2, 4, 6, 7, 8, 9, 10, 11, 12, 13, 14, 16, 18, 20
+	};
+	double clamped = max(-1.0, min(1.0, s));
+	double pos = (clamped + 1.0) * 7.0;
+	size_t idx = (size_t)pos;
+	double factor;
+
+	if (idx >= ARRAY_LENGTH(factors) - 1) {
+		factor = factors[ARRAY_LENGTH(factors) - 1];
+	} else {
+		double frac = pos - (double)idx;
+		factor = factors[idx] + frac * (factors[idx + 1] - factors[idx]);
+	}
+
+	return 0.64 * (factor / 10.0);
+}
+
+static bool
+touchpad_opd2413_set_speed(struct motion_filter *filter, double speed_adjustment)
+{
+	struct touchpad_accelerator *accel_filter =
+		(struct touchpad_accelerator *)filter;
+
+	assert(speed_adjustment >= -1.0 && speed_adjustment <= 1.0);
+
+	filter->speed_adjustment = speed_adjustment;
+	accel_filter->speed_factor = opd2413_speed_factor(speed_adjustment);
+
+	return true;
+}
+
+double
+touchpad_opd2413_accel_profile_linear(struct motion_filter *filter,
+				      void *data,
+				      double speed_in, /* device units/us */
+				      usec_t time)
+{
+	struct touchpad_accelerator *accel_filter =
+		(struct touchpad_accelerator *)filter;
+	double v = v_us2s(speed_in) * 25.4 / accel_filter->dpi;
+	double scale = accel_filter->display_scale > 0.0
+			       ? accel_filter->display_scale
+			       : 2.5;
+	double g_base;
+
+	/*
+	 * ColorOS 16 OPD2413 4-segment cursor acceleration curve mapped from
+	 * physical pixels/s (ScalingFilterInterpreter factor 7.85433054) to
+	 * libinput's normalized 1000-DPI logical pixels at display_scale.
+	 */
+	if (v <= 32.002)
+		g_base = 3.19;
+	else if (v <= 52.830)
+		g_base = 4.79 - 51.254 / v;
+	else if (v <= 119.124)
+		g_base = 7.28 - 182.737 / v;
+	else
+		g_base = 15.04 - 1107.556 / v;
+
+	return g_base * accel_filter->speed_factor * (7.85433054 / scale) *
+	       (25.4 / 1000.0);
+}
+
+static const struct motion_filter_interface accelerator_interface_touchpad_opd2413 = {
+	.type = LIBINPUT_CONFIG_ACCEL_PROFILE_ADAPTIVE,
+	.filter = accelerator_filter_touchpad,
+	.filter_constant = touchpad_constant_filter,
+	.filter_scroll = touchpad_scroll_filter,
+	.restart = touchpad_accelerator_restart,
+	.destroy = touchpad_accelerator_destroy,
+	.set_speed = touchpad_opd2413_set_speed,
+};
+
+struct motion_filter *
+create_pointer_accelerator_filter_oneplus_opd2413(
+	int dpi,
+	usec_t event_delta_smooth_threshold,
+	usec_t event_delta_smooth_value,
+	bool use_velocity_averaging)
+{
+	struct touchpad_accelerator *filter;
+
+	filter = zalloc(sizeof *filter);
+	filter->last_velocity = 0.0;
+
+	trackers_init(&filter->trackers, use_velocity_averaging ? 16 : 2);
+
+	filter->threshold = 130;
+	filter->dpi = dpi;
+	filter->display_scale = opd2413_detect_display_scale();
+	filter->speed_factor = opd2413_speed_factor(0.0);
+
+	filter->base.interface = &accelerator_interface_touchpad_opd2413;
+	filter->profile = touchpad_opd2413_accel_profile_linear;
+	filter->trackers.smoothener =
+		pointer_delta_smoothener_create(event_delta_smooth_threshold,
+						event_delta_smooth_value);
+
+	return &filter->base;
+}
