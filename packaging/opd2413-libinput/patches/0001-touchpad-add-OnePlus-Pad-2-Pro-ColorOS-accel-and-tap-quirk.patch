+++ b/src/evdev-mt-touchpad-tap.c
@@ -153,7 +153,13 @@ tp_tap_notify(struct tp_dispatch *tp,
 static void
 tp_tap_set_timer(struct tp_dispatch *tp, usec_t time)
 {
-	libinput_timer_set(&tp->tap.timer, usec_add(time, DEFAULT_TAP_TIMEOUT_PERIOD));
+	usec_t timeout = DEFAULT_TAP_TIMEOUT_PERIOD;
+
+	if (evdev_device_has_model_quirk(tp->device,
+					 QUIRK_MODEL_ONEPLUS_OPD2413_TOUCHPAD))
+		timeout = usec_from_millis(220);
+
+	libinput_timer_set(&tp->tap.timer, usec_add(time, timeout));
 }
 
 static void
@@ -1207,7 +1213,13 @@ tp_tap_exceeds_motion_threshold(struct tp_dispatch *tp, struct tp_touch *t)
 	if (tp->semi_mt && tp->nfingers_down != tp->old_nfingers_down)
 		return false;
 
-	return length_in_mm(mm) > DEFAULT_TAP_MOVE_THRESHOLD;
+	double threshold = DEFAULT_TAP_MOVE_THRESHOLD;
+
+	if (evdev_device_has_model_quirk(tp->device,
+					 QUIRK_MODEL_ONEPLUS_OPD2413_TOUCHPAD))
+		threshold = 2.0;
+
+	return length_in_mm(mm) > threshold;
 }
 
