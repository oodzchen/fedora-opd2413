--- /dev/null
+++ b/src/libcamera/shaders/rgb_post.frag
@@ -0,0 +1,111 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+/*
+ * Copyright (C) 2026, Fedora OPD2413 contributors
+ *
+ * Gain-adaptive YCbCr joint-bilateral chroma/luma denoising and clamped
+ * contrast-adaptive sharpening post-process shader.
+ */
+
+#ifdef GL_ES
+precision highp float;
+#endif
+
+varying vec2 textureOut;
+
+uniform sampler2D tex_rgb;
+uniform vec2 post_step;
+uniform float sensor_gain;
+
+vec3 rgb2ycc(vec3 c)
+{
+	float y = dot(c, vec3(0.299, 0.587, 0.114));
+	return vec3(y, c.r - y, c.b - y);
+}
+
+vec3 ycc2rgb(vec3 ycc)
+{
+	float r = ycc.x + ycc.y;
+	float g = ycc.x - 0.50937 * ycc.y - 0.19421 * ycc.z;
+	float b = ycc.x + ycc.z;
+	return vec3(r, g, b);
+}
+
+void main(void)
+{
+	vec3 c0 = rgb2ycc(texture2D(tex_rgb, textureOut).rgb);
+
+	float gainNorm = clamp((sensor_gain - 1.0) / 15.0, 0.0, 1.0);
+	float sigmaChromaY = mix(0.055, 0.16, gainNorm);
+	float sigmaLumaY = mix(0.014, 0.042, gainNorm);
+	float sharpAmount = mix(0.32, 0.14, gainNorm);
+
+	float ySum = c0.x;
+	float yW = 1.0;
+	vec2 cSum = c0.yz;
+	float cW = 1.0;
+
+	float minY = c0.x;
+	float maxY = c0.x;
+	float crossSum = 0.0;
+	float diagSum = 0.0;
+
+	/* 3x3 full neighborhood for joint-bilateral luma/chroma NR + CAS bounds */
+	for (int dy = -1; dy <= 1; dy++) {
+		for (int dx = -1; dx <= 1; dx++) {
+			if (dx == 0 && dy == 0)
+				continue;
+
+			vec2 uv = textureOut + vec2(float(dx), float(dy)) * post_step;
+			vec3 n = rgb2ycc(texture2D(tex_rgb, uv).rgb);
+			float dY = abs(n.x - c0.x);
+
+			minY = min(minY, n.x);
+			maxY = max(maxY, n.x);
+			if (dx == 0 || dy == 0)
+				crossSum += n.x;
+			else
+				diagSum += n.x;
+
+			float spatial = (dx == 0 || dy == 0) ? 0.70 : 0.45;
+			float wl = spatial * exp(-(dY * dY) / max(2.0 * sigmaLumaY * sigmaLumaY, 1e-6));
+			ySum += n.x * wl;
+			yW += wl;
+
+			float wc = spatial * exp(-(dY * dY) / max(2.0 * sigmaChromaY * sigmaChromaY, 1e-6));
+			cSum += n.yz * wc;
+			cW += wc;
+		}
+	}
+
+	/* Sparse radius-2 taps suppress wider-area color noise without blurring edges */
+	for (int i = 0; i < 8; i++) {
+		vec2 ofs = vec2(0.0);
+		if (i == 0) ofs = vec2(-2.0,  0.0);
+		else if (i == 1) ofs = vec2( 2.0,  0.0);
+		else if (i == 2) ofs = vec2( 0.0, -2.0);
+		else if (i == 3) ofs = vec2( 0.0,  2.0);
+		else if (i == 4) ofs = vec2(-2.0, -2.0);
+		else if (i == 5) ofs = vec2( 2.0, -2.0);
+		else if (i == 6) ofs = vec2(-2.0,  2.0);
+		else ofs = vec2( 2.0,  2.0);
+
+		vec3 n = rgb2ycc(texture2D(tex_rgb, textureOut + ofs * post_step).rgb);
+		float dY = abs(n.x - c0.x);
+		float wc = 0.35 * exp(-(dY * dY) / max(2.0 * sigmaChromaY * sigmaChromaY, 1e-6));
+		cSum += n.yz * wc;
+		cW += wc;
+	}
+
+	float yDenoised = ySum / yW;
+	float yBlur = (4.0 * c0.x + 2.0 * crossSum + diagSum) / 16.0;
+	float ySharp = yDenoised + sharpAmount * (yDenoised - yBlur);
+	float yOut = clamp(ySharp, minY - 0.015 * sharpAmount, maxY + 0.015 * sharpAmount);
+
+	vec3 rgb = clamp(ycc2rgb(vec3(yOut, cSum / cW)), 0.0, 1.0);
+
+#if defined(SWAP_BLUE)
+	gl_FragColor = vec4(rgb.bgr, 1.0);
+#else
+	gl_FragColor = vec4(rgb, 1.0);
+#endif
+}
