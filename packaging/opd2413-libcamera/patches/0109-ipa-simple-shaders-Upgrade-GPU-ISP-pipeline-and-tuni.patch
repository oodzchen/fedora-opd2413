diff --git a/src/ipa/simple/algorithms/agc.cpp b/src/ipa/simple/algorithms/agc.cpp
index db5498c..58de2bf 100644
--- a/src/ipa/simple/algorithms/agc.cpp
+++ b/src/ipa/simple/algorithms/agc.cpp
@@ -27,10 +27,10 @@ namespace ipa::soft::algorithms {
 static constexpr unsigned int kExposureBinsCount = 5;
 
 /*
- * The exposure is optimal when the mean sample value of the histogram is
- * in the middle of the range.
+ * The exposure is optimal slightly below mid-range so radial LSC (~1.5-2.5x)
+ * and AWB gains retain highlight headroom before Filmic tone compression.
  */
-static constexpr float kExposureOptimal = kExposureBinsCount / 2.0;
+static constexpr float kExposureOptimal = 2.2f;
 
 /*
  * This implements the hysteresis for the exposure adjustment.
@@ -197,6 +197,16 @@ void Agc::process(IPAContext &context,
 	}
 
 	float exposureMSV = (denom == 0 ? 0 : static_cast<float>(num) / denom);
+	if (denom > 0) {
+		unsigned int clipCount = 0;
+		const unsigned int clipStart =
+			SwIspStats::kYHistogramSize > 6 ? SwIspStats::kYHistogramSize - 6 : SwIspStats::kYHistogramSize - 1;
+		for (unsigned int i = clipStart; i < SwIspStats::kYHistogramSize; i++)
+			clipCount += histogram[i];
+		const float satRatio = static_cast<float>(clipCount) / static_cast<float>(denom);
+		if (satRatio > 0.025f)
+			exposureMSV += std::clamp((satRatio - 0.025f) * 10.0f, 0.0f, 1.4f);
+	}
 	context.activeState.agc.lastUpdateFrame = frame;
 	context.activeState.agc.updated = true;
 	updateExposure(context, frameContext, exposureMSV);
diff --git a/src/ipa/simple/algorithms/awb.cpp b/src/ipa/simple/algorithms/awb.cpp
index 05155c8..6cf79dd 100644
--- a/src/ipa/simple/algorithms/awb.cpp
+++ b/src/ipa/simple/algorithms/awb.cpp
@@ -7,6 +7,7 @@
 
 #include "awb.h"
 
+#include <algorithm>
 #include <numeric>
 #include <stdint.h>
 
@@ -59,31 +60,39 @@ void Awb::process(IPAContext &context,
 		return;
 
 	/*
-	 * Black level must be subtracted to get the correct AWB ratios, they
-	 * would be off if they were computed from the whole brightness range
-	 * rather than from the sensor range.
+	 * Black level must be subtracted using the exact pixel count matching
+	 * the accumulated channel sums. Prefer unsaturated, above-black-level
+	 * AWB samples whenever at least 1/16 of sampled pixels qualify.
 	 */
-	const uint64_t nPixels = std::accumulate(
+	const uint64_t nAllPixels = std::accumulate(
 		histogram.begin(), histogram.end(), uint64_t(0));
-	const uint64_t offset = blackLevel * nPixels;
+	const bool useFiltered = stats->awbSamples >= std::max<uint64_t>(64, nAllPixels / 16);
+	const uint64_t nPixels = useFiltered ? stats->awbSamples : nAllPixels;
+	const RGB<uint64_t> &rawSum = useFiltered ? stats->awbSum_ : stats->sum_;
+	const uint64_t offset = static_cast<uint64_t>(blackLevel) * nPixels;
 	const uint64_t minValid = 1;
 	/*
 	 * Make sure the sums are at least minValid, while preventing unsigned
 	 * integer underflow.
 	 */
-	const RGB<uint64_t> sum = stats->sum_.max(offset + minValid) - offset;
+	const RGB<uint64_t> sum = rawSum.max(offset + minValid) - offset;
 
 	/*
-	 * Calculate red and blue gains for AWB.
-	 * Clamp max gain at 4.0, this also avoids 0 division.
+	 * Calculate red and blue gains for AWB, clamped to avoid colour cast
+	 * runaway on extreme scenes, and smooth temporally after frame 0.
 	 */
-	auto &gains = context.activeState.awb.gains;
-	gains = { {
-		sum.r() <= sum.g() / 4 ? 4.0f : static_cast<float>(sum.g()) / sum.r(),
-		1.0,
-		sum.b() <= sum.g() / 4 ? 4.0f : static_cast<float>(sum.g()) / sum.b(),
+	const RGB<float> targetGains{ {
+		sum.r() <= sum.g() / 4 ? 3.2f : std::clamp(static_cast<float>(sum.g()) / sum.r(), 0.85f, 3.2f),
+		1.0f,
+		sum.b() <= sum.g() / 4 ? 3.2f : std::clamp(static_cast<float>(sum.g()) / sum.b(), 0.85f, 3.2f),
 	} };
 
+	auto &gains = context.activeState.awb.gains;
+	if (context.activeState.awb.temperatureK == 0)
+		gains = targetGains;
+	else
+		gains = gains * 0.65f + targetGains * 0.35f;
+
 	RGB<double> rgbGains{ { 1 / gains.r(), 1 / gains.g(), 1 / gains.b() } };
 	context.activeState.awb.temperatureK = estimateCCT(rgbGains);
 	metadata.set(controls::ColourTemperature, context.activeState.awb.temperatureK);
