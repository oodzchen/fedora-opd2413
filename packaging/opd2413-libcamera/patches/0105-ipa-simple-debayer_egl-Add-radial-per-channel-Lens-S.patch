diff --git a/src/ipa/simple/algorithms/lsc.cpp b/src/ipa/simple/algorithms/lsc.cpp
new file mode 100644
index 0000000..9dbf365
--- /dev/null
+++ b/src/ipa/simple/algorithms/lsc.cpp
@@ -0,0 +1,66 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+/*
+ * Copyright (C) 2026, Fedora OPD2413 contributors
+ *
+ * Radial Lens Shading Correction for Simple Software ISP
+ */
+
+#include "lsc.h"
+
+#include <libcamera/base/log.h>
+
+#include "libcamera/internal/value_node.h"
+
+namespace libcamera {
+
+namespace ipa::soft::algorithms {
+
+LOG_DEFINE_CATEGORY(IPASoftLsc)
+
+namespace {
+
+void parseChannel(const ValueNode &node, float &cx, float &cy, float &k1, float &k2)
+{
+	if (!node)
+		return;
+
+	cx = static_cast<float>(node["cx"].get<double>().value_or(cx));
+	cy = static_cast<float>(node["cy"].get<double>().value_or(cy));
+	/* Support DNG k0/k1 naming (k0 -> r^2 term, k1 -> r^4 term). */
+	k1 = static_cast<float>(node["k0"].get<double>().value_or(k1));
+	k2 = static_cast<float>(node["k1"].get<double>().value_or(k2));
+}
+
+} /* namespace */
+
+int Lsc::init([[maybe_unused]] IPAContext &context, const ValueNode &tuningData)
+{
+	parseChannel(tuningData["r"], cx_.r(), cy_.r(), k1_.r(), k2_.r());
+	parseChannel(tuningData["g"], cx_.g(), cy_.g(), k1_.g(), k2_.g());
+	parseChannel(tuningData["b"], cx_.b(), cy_.b(), k1_.b(), k2_.b());
+
+	LOG(IPASoftLsc, Info)
+		<< "Configured radial LSC: cx=" << cx_
+		<< " cy=" << cy_
+		<< " k0=" << k1_
+		<< " k1=" << k2_;
+
+	return 0;
+}
+
+void Lsc::prepare([[maybe_unused]] IPAContext &context,
+		  [[maybe_unused]] const uint32_t frame,
+		  [[maybe_unused]] IPAFrameContext &frameContext,
+		  DebayerParams *params)
+{
+	params->lscCx = cx_;
+	params->lscCy = cy_;
+	params->lscK1 = k1_;
+	params->lscK2 = k2_;
+}
+
+REGISTER_IPA_ALGORITHM(Lsc, "Lsc")
+
+} /* namespace ipa::soft::algorithms */
+
+} /* namespace libcamera */
diff --git a/src/ipa/simple/algorithms/lsc.h b/src/ipa/simple/algorithms/lsc.h
new file mode 100644
index 0000000..f21513b
--- /dev/null
+++ b/src/ipa/simple/algorithms/lsc.h
@@ -0,0 +1,39 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+/*
+ * Copyright (C) 2026, Fedora OPD2413 contributors
+ *
+ * Radial Lens Shading Correction for Simple Software ISP
+ */
+
+#pragma once
+
+#include "libcamera/internal/vector.h"
+
+#include "algorithm.h"
+
+namespace libcamera {
+
+namespace ipa::soft::algorithms {
+
+class Lsc : public Algorithm
+{
+public:
+	Lsc() = default;
+	~Lsc() = default;
+
+	int init(IPAContext &context, const ValueNode &tuningData) override;
+	void prepare(IPAContext &context,
+		     const uint32_t frame,
+		     IPAFrameContext &frameContext,
+		     DebayerParams *params) override;
+
+private:
+	RGB<float> cx_{ { 0.5f, 0.5f, 0.5f } };
+	RGB<float> cy_{ { 0.5f, 0.5f, 0.5f } };
+	RGB<float> k1_{ { 0.0f, 0.0f, 0.0f } };
+	RGB<float> k2_{ { 0.0f, 0.0f, 0.0f } };
+};
+
+} /* namespace ipa::soft::algorithms */
+
+} /* namespace libcamera */
