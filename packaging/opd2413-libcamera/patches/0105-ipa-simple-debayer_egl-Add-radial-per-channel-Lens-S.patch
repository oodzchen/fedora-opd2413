index 95cc63a..d6a718d 100644
--- a/src/ipa/simple/soft_simple.cpp
+++ b/src/ipa/simple/soft_simple.cpp
@@ -163,6 +163,10 @@ int IPASoftSimple::init(const IPASettings &settings,
 		params_->gamma = 1.0 / algorithms::kDefaultGamma;
 		params_->contrastExp = 1.0;
 		params_->gains = { { 1.0, 1.0, 1.0 } };
+		params_->lscCx = { { 0.5, 0.5, 0.5 } };
+		params_->lscCy = { { 0.5, 0.5, 0.5 } };
+		params_->lscK1 = { { 0.0, 0.0, 0.0 } };
+		params_->lscK2 = { { 0.0, 0.0, 0.0 } };
 		/* combinedMatrix is reset for each frame. */
 	}
 
diff --git a/src/libcamera/shaders/bayer_1x_packed.frag b/src/libcamera/shaders/bayer_1x_packed.frag
index 0b641a5..5fe68ef 100644
--- a/src/libcamera/shaders/bayer_1x_packed.frag
+++ b/src/libcamera/shaders/bayer_1x_packed.frag
@@ -70,6 +70,19 @@ uniform mat3 ccm;
 uniform vec3 blacklevel;
 uniform float gamma;
 uniform float contrastExp;
+uniform vec4 lscR;
+uniform vec4 lscG;
+uniform vec4 lscB;
+
+float lsc_eval(vec2 uv, vec2 imgSize, vec4 p)
+{
+	vec2 centerPx = p.xy * imgSize;
+	vec2 maxDist = max(centerPx, imgSize - centerPx);
+	float m2 = max(dot(maxDist, maxDist), 1.0);
+	vec2 dPx = (uv - p.xy) * imgSize;
+	float r2 = dot(dPx, dPx) / m2;
+	return max(1.0, 1.0 + p.z * r2 + p.w * r2 * r2);
+}
 
 float apply_contrast(float value)
 {
@@ -230,10 +243,15 @@ void main(void)
 	 * \todo: Black level normalising, AWB and digital gain could be
 	 * reworked into a single multiplication.
 	 */
-	rgb = (rgb - blacklevel) / (1.0 - blacklevel);
+	rgb = max((rgb - blacklevel) / (1.0 - blacklevel), vec3(0.0));
+
+	/* Lens Shading Correction (radial DNG polynomial) */
+	vec3 lscGain = vec3(lsc_eval(textureOut, tex_size, lscR),
+			    lsc_eval(textureOut, tex_size, lscG),
+			    lsc_eval(textureOut, tex_size, lscB));
 
-	/* Apply AWB gains, and saturate each channel at sensor range */
-	rgb = clamp(rgb * awb, vec3(0.0), vec3(1.0));
+	/* Apply LSC and AWB gains, and saturate each channel at sensor range */
+	rgb = clamp(rgb * lscGain * awb, vec3(0.0), vec3(1.0));
 
 	/* Colour Correction Matrix */
 	rgb = ccm * rgb;
diff --git a/src/libcamera/shaders/bayer_unpacked.frag b/src/libcamera/shaders/bayer_unpacked.frag
index 10c5e94..f7ccbb6 100644
--- a/src/libcamera/shaders/bayer_unpacked.frag
+++ b/src/libcamera/shaders/bayer_unpacked.frag
@@ -29,6 +29,21 @@ uniform mat3            ccm;
 uniform vec3            blacklevel;
 uniform float           gamma;
 uniform float           contrastExp;
+uniform vec2            tex_size;
+uniform float           stride_factor;
+uniform vec4            lscR;
+uniform vec4            lscG;
+uniform vec4            lscB;
+
+float lsc_eval(vec2 uv, vec2 imgSize, vec4 p)
+{
+    vec2 centerPx = p.xy * imgSize;
+    vec2 maxDist = max(centerPx, imgSize - centerPx);
+    float m2 = max(dot(maxDist, maxDist), 1.0);
+    vec2 dPx = (uv - p.xy) * imgSize;
+    float r2 = dot(dPx, dPx) / m2;
+    return max(1.0, 1.0 + p.z * r2 + p.w * r2 * r2);
+}
 
 float apply_contrast(float value)
 {
@@ -133,10 +148,16 @@ void main(void) {
      * \todo: Black level normalising, AWB and digital gain could be
      * reworked into a single multiplication.
      */
-    rgb = (rgb - blacklevel) / (1.0 - blacklevel);
+    rgb = max((rgb - blacklevel) / (1.0 - blacklevel), vec3(0.0));
+
+    /* Lens Shading Correction (radial DNG polynomial) */
+    vec2 lscUv = vec2(center.x / max(stride_factor, 0.0001), center.y);
+    vec3 lscGain = vec3(lsc_eval(lscUv, tex_size, lscR),
+                        lsc_eval(lscUv, tex_size, lscG),
+                        lsc_eval(lscUv, tex_size, lscB));
 
-    /* Apply AWB gains, and saturate each channel at sensor range */
-    rgb = clamp(rgb * awb, vec3(0.0), vec3(1.0));
+    /* Apply LSC and AWB gains, and saturate each channel at sensor range */
+    rgb = clamp(rgb * lscGain * awb, vec3(0.0), vec3(1.0));
 
     /* Colour Correction Matrix */
     rgb = ccm * rgb;
diff --git a/src/libcamera/software_isp/debayer_egl.cpp b/src/libcamera/software_isp/debayer_egl.cpp
index 02651fe..20a2a60 100644
--- a/src/libcamera/software_isp/debayer_egl.cpp
+++ b/src/libcamera/software_isp/debayer_egl.cpp
@@ -121,6 +121,9 @@ int DebayerEGL::getShaderVariableLocations(void)
 	blackLevelUniformDataIn_ = glGetUniformLocation(programId_, "blacklevel");
 	gammaUniformDataIn_ = glGetUniformLocation(programId_, "gamma");
 	contrastExpUniformDataIn_ = glGetUniformLocation(programId_, "contrastExp");
+	lscRUniformDataIn_ = glGetUniformLocation(programId_, "lscR");
+	lscGUniformDataIn_ = glGetUniformLocation(programId_, "lscG");
+	lscBUniformDataIn_ = glGetUniformLocation(programId_, "lscB");
 
 	textureUniformStep_ = glGetUniformLocation(programId_, "tex_step");
 	textureUniformSize_ = glGetUniformLocation(programId_, "tex_size");
@@ -504,6 +507,16 @@ void DebayerEGL::setShaderVariableValues(eGLImage &eglImageIn, const DebayerPara
 	glUniform1f(contrastExpUniformDataIn_, params.contrastExp);
 	LOG(Debayer, Debug) << " contrastExpUniformDataIn_ " << contrastExpUniformDataIn_ << " data " << params.contrastExp;
 
+	/*
+	 * Lens Shading Correction
+	 */
+	glUniform4f(lscRUniformDataIn_, params.lscCx.r(), params.lscCy.r(),
+		    params.lscK1.r(), params.lscK2.r());
+	glUniform4f(lscGUniformDataIn_, params.lscCx.g(), params.lscCy.g(),
+		    params.lscK1.g(), params.lscK2.g());
+	glUniform4f(lscBUniformDataIn_, params.lscCx.b(), params.lscCy.b(),
+		    params.lscK1.b(), params.lscK2.b());
+
 	return;
 }
 
