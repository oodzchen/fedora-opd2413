diff --git a/src/ipa/simple/algorithms/af.cpp b/src/ipa/simple/algorithms/af.cpp
new file mode 100644
index 0000000..3d46ee8
--- /dev/null
+++ b/src/ipa/simple/algorithms/af.cpp
@@ -0,0 +1,343 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+/*
+ * Copyright (C) 2026, Fedora OPD2413 contributors
+ *
+ * Contrast-detect autofocus for Simple Software ISP
+ */
+
+#include "af.h"
+
+#include <algorithm>
+#include <cmath>
+
+#include <linux/v4l2-controls.h>
+
+#include <libcamera/base/log.h>
+#include <libcamera/control_ids.h>
+
+#include "libcamera/internal/value_node.h"
+
+namespace libcamera {
+
+namespace ipa::soft::algorithms {
+
+LOG_DEFINE_CATEGORY(IPASoftAf)
+
+namespace {
+
+constexpr float kMaxDioptres = 15.0f;
+constexpr float kDefaultDioptres = 2.0f;
+
+} /* namespace */
+
+int Af::init(IPAContext &context, const ValueNode &tuningData)
+{
+	const auto it = context.lensControls.find(V4L2_CID_FOCUS_ABSOLUTE);
+	if (it == context.lensControls.end()) {
+		hasLens_ = false;
+		return 0;
+	}
+
+	hwMinStep_ = it->second.min().get<int32_t>();
+	hwMaxStep_ = it->second.max().get<int32_t>();
+	if (hwMaxStep_ <= hwMinStep_) {
+		hasLens_ = false;
+		return 0;
+	}
+
+	hasLens_ = true;
+	const int32_t span = hwMaxStep_ - hwMinStep_;
+	scanMinStep_ = std::clamp(
+		tuningData["minStep"].get<int32_t>(hwMinStep_ + span / 12),
+		hwMinStep_, hwMaxStep_);
+	scanMaxStep_ = std::clamp(
+		tuningData["maxStep"].get<int32_t>(hwMaxStep_ - span / 12),
+		scanMinStep_, hwMaxStep_);
+	coarseStep_ = std::max(1, tuningData["coarseStep"].get<int32_t>(span / 16));
+	fineStep_ = std::max(1, tuningData["fineStep"].get<int32_t>(coarseStep_ / 4));
+	settleFrames_ = std::max<uint32_t>(1, tuningData["settleFrames"].get<uint32_t>(2));
+	warmupFrames_ = tuningData["warmupFrames"].get<uint32_t>(4);
+	retriggerRatio_ = tuningData["retriggerRatio"].get<double>(0.72);
+
+	mode_ = controls::AfModeContinuous;
+	context.ctrlMap[&controls::AfMode] = ControlInfo(controls::AfModeValues);
+	context.ctrlMap[&controls::AfTrigger] = ControlInfo(controls::AfTriggerValues);
+	context.ctrlMap[&controls::LensPosition] =
+		ControlInfo(0.0f, kMaxDioptres, kDefaultDioptres);
+
+	LOG(IPASoftAf, Info)
+		<< "Contrast AF enabled: hw=[" << hwMinStep_ << ".." << hwMaxStep_
+		<< "] scan=[" << scanMinStep_ << ".." << scanMaxStep_
+		<< "] coarse=" << coarseStep_ << " fine=" << fineStep_;
+
+	return 0;
+}
+
+int Af::configure(IPAContext &context, const IPAConfigInfo &configInfo)
+{
+	if (!hasLens_)
+		return 0;
+
+	const auto it = configInfo.lensControls.find(V4L2_CID_FOCUS_ABSOLUTE);
+	if (it != configInfo.lensControls.end()) {
+		hwMinStep_ = it->second.min().get<int32_t>();
+		hwMaxStep_ = it->second.max().get<int32_t>();
+	}
+
+	context.activeState.af.hasLens = true;
+	context.activeState.af.currentStep = -1;
+	context.activeState.af.dirty = false;
+
+	defocusStreak_ = 0;
+	lockCooldown_ = 0;
+	bestScore_ = 0.0;
+	lockedScore_ = 0.0;
+	lockedLuma_ = 0.0;
+
+	if (mode_ == controls::AfModeContinuous) {
+		state_ = ScanState::Warmup;
+		waitFrames_ = warmupFrames_;
+		moveLens(context, dioptresToStep(kDefaultDioptres));
+	} else {
+		state_ = ScanState::Idle;
+		moveLens(context, dioptresToStep(kDefaultDioptres));
+	}
+
+	return 0;
+}
+
+void Af::queueRequest(IPAContext &context,
+		      [[maybe_unused]] const uint32_t frame,
+		      [[maybe_unused]] IPAFrameContext &frameContext,
+		      const ControlList &controls)
+{
+	if (!hasLens_)
+		return;
+
+	if (const auto &afMode = controls.get(controls::AfMode)) {
+		if (*afMode != mode_) {
+			mode_ = *afMode;
+			defocusStreak_ = 0;
+			if (mode_ == controls::AfModeManual) {
+				state_ = ScanState::Idle;
+			} else if (mode_ == controls::AfModeContinuous) {
+				startScan(context, false);
+			} else {
+				state_ = ScanState::Idle;
+			}
+		}
+	}
+
+	if (mode_ == controls::AfModeManual) {
+		if (const auto &lensPos = controls.get(controls::LensPosition))
+			moveLens(context, dioptresToStep(*lensPos));
+		return;
+	}
+
+	if (const auto &trigger = controls.get(controls::AfTrigger)) {
+		if (*trigger == controls::AfTriggerStart) {
+			startScan(context, false);
+		} else if (*trigger == controls::AfTriggerCancel &&
+			   mode_ == controls::AfModeAuto) {
+			state_ = ScanState::Idle;
+		}
+	}
+}
+
+void Af::process(IPAContext &context,
+		 [[maybe_unused]] const uint32_t frame,
+		 [[maybe_unused]] IPAFrameContext &frameContext,
+		 const SwIspStats *stats,
+		 ControlList &metadata)
+{
+	if (!hasLens_)
+		return;
+
+	int32_t afState = controls::AfStateIdle;
+	if (state_ == ScanState::CoarseScan || state_ == ScanState::FineScan ||
+	    state_ == ScanState::Warmup)
+		afState = controls::AfStateScanning;
+	else if (state_ == ScanState::Locked)
+		afState = controls::AfStateFocused;
+
+	metadata.set(controls::AfState, afState);
+	metadata.set(controls::LensPosition,
+		     stepToDioptres(context.activeState.af.targetStep));
+
+	if (!stats->valid || stats->focusSamples == 0)
+		return;
+
+	double meanLuma = 0.0;
+	const double score = computeScore(stats, meanLuma);
+
+	if (waitFrames_ > 0) {
+		waitFrames_--;
+		return;
+	}
+
+	switch (state_) {
+	case ScanState::Idle:
+		break;
+
+	case ScanState::Warmup:
+		startScan(context, false);
+		break;
+
+	case ScanState::CoarseScan:
+		if (score > bestScore_) {
+			bestScore_ = score;
+			bestPos_ = currentScanPos_;
+		}
+
+		currentScanPos_ += scanIncrement_;
+		if (currentScanPos_ <= scanEnd_) {
+			moveLens(context, currentScanPos_);
+			waitFrames_ = settleFrames_;
+		} else {
+			/* Switch to fine hill-climb around best coarse peak. */
+			state_ = ScanState::FineScan;
+			scanIncrement_ = fineStep_;
+			const int32_t fineStart = std::max(scanMinStep_, bestPos_ - coarseStep_);
+			scanEnd_ = std::min(scanMaxStep_, bestPos_ + coarseStep_);
+			currentScanPos_ = fineStart;
+			bestScore_ = 0.0;
+			moveLens(context, currentScanPos_);
+			waitFrames_ = settleFrames_;
+		}
+		break;
+
+	case ScanState::FineScan:
+		if (score > bestScore_) {
+			bestScore_ = score;
+			bestPos_ = currentScanPos_;
+		}
+
+		currentScanPos_ += scanIncrement_;
+		if (currentScanPos_ <= scanEnd_) {
+			moveLens(context, currentScanPos_);
+			waitFrames_ = settleFrames_;
+		} else {
+			if (wasLocalScan_ && bestScore_ < lockedScore_ * 0.85) {
+				/* Local hill no longer covers subject; run full sweep. */
+				startScan(context, false);
+				break;
+			}
+			moveLens(context, bestPos_);
+			lockedScore_ = bestScore_;
+			lockedLuma_ = meanLuma;
+			state_ = ScanState::Locked;
+			defocusStreak_ = 0;
+			lockCooldown_ = 30;
+			LOG(IPASoftAf, Debug)
+				<< "AF locked at step=" << bestPos_
+				<< " score=" << lockedScore_;
+		}
+		break;
+
+	case ScanState::Locked:
+		if (mode_ != controls::AfModeContinuous)
+			break;
+
+		if (lockCooldown_ > 0) {
+			lockCooldown_--;
+			/* Refresh baseline once lens has finished settling. */
+			if (lockCooldown_ == 15) {
+				lockedScore_ = score;
+				lockedLuma_ = meanLuma;
+			}
+			break;
+		}
+
+		const bool sharpnessDrop =
+			(lockedScore_ > 0.0) && (score < lockedScore_ * retriggerRatio_);
+		const bool lumaShift =
+			(lockedLuma_ > 1.0) &&
+			(std::abs(meanLuma - lockedLuma_) > lockedLuma_ * 0.35);
+
+		if (sharpnessDrop || lumaShift) {
+			if (++defocusStreak_ >= 5) {
+				LOG(IPASoftAf, Debug)
+					<< "AF retrigger score=" << score
+					<< " baseline=" << lockedScore_;
+				startScan(context, !lumaShift);
+			}
+		} else {
+			defocusStreak_ = 0;
+		}
+		break;
+	}
+}
+
+void Af::startScan(IPAContext &context, bool localOnly)
+{
+	defocusStreak_ = 0;
+	bestScore_ = 0.0;
+	wasLocalScan_ = localOnly;
+
+	if (localOnly) {
+		state_ = ScanState::FineScan;
+		scanIncrement_ = fineStep_;
+		const int32_t center = context.activeState.af.targetStep;
+		currentScanPos_ = std::max(scanMinStep_, center - coarseStep_ * 2);
+		scanEnd_ = std::min(scanMaxStep_, center + coarseStep_ * 2);
+	} else {
+		state_ = ScanState::CoarseScan;
+		scanIncrement_ = coarseStep_;
+		currentScanPos_ = scanMinStep_;
+		scanEnd_ = scanMaxStep_;
+	}
+
+	bestPos_ = currentScanPos_;
+	moveLens(context, currentScanPos_);
+	waitFrames_ = settleFrames_;
+}
+
+void Af::moveLens(IPAContext &context, int32_t step)
+{
+	step = std::clamp(step, hwMinStep_, hwMaxStep_);
+	context.activeState.af.targetStep = step;
+	if (step != context.activeState.af.currentStep) {
+		context.activeState.af.currentStep = step;
+		context.activeState.af.dirty = true;
+	}
+}
+
+double Af::computeScore(const SwIspStats *stats, double &meanLuma) const
+{
+	uint64_t totalCount = 0;
+	double weightedSum = 0.0;
+	for (unsigned int i = 0; i < SwIspStats::kYHistogramSize; i++) {
+		const uint32_t count = stats->yHistogram[i];
+		totalCount += count;
+		weightedSum += static_cast<double>(i) * static_cast<double>(count);
+	}
+
+	meanLuma = totalCount > 0 ? weightedSum / static_cast<double>(totalCount) : 0.0;
+	const double avgGradientSq =
+		static_cast<double>(stats->focusMetric) /
+		static_cast<double>(stats->focusSamples);
+	return avgGradientSq / (meanLuma * meanLuma + 4.0);
+}
+
+float Af::stepToDioptres(int32_t step) const
+{
+	if (hwMaxStep_ <= hwMinStep_)
+		return 0.0f;
+
+	const float ratio = static_cast<float>(step - hwMinStep_) /
+			    static_cast<float>(hwMaxStep_ - hwMinStep_);
+	return std::clamp(ratio * kMaxDioptres, 0.0f, kMaxDioptres);
+}
+
+int32_t Af::dioptresToStep(float dioptres) const
+{
+	const float ratio = std::clamp(dioptres / kMaxDioptres, 0.0f, 1.0f);
+	return hwMinStep_ +
+	       static_cast<int32_t>(std::lround(ratio * static_cast<float>(hwMaxStep_ - hwMinStep_)));
+}
+
+REGISTER_IPA_ALGORITHM(Af, "Af")
+
+} /* namespace ipa::soft::algorithms */
+
+} /* namespace libcamera */
