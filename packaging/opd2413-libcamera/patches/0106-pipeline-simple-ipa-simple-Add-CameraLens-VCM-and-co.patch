+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+/*
+ * Copyright (C) 2026, Fedora OPD2413 contributors
+ *
+ * Contrast-detect autofocus for Simple Software ISP
+ */
+
+#pragma once
+
+#include <stdint.h>
+
+#include "algorithm.h"
+
+namespace libcamera {
+
+namespace ipa::soft::algorithms {
+
+class Af : public Algorithm
+{
+public:
+	Af() = default;
+	~Af() = default;
+
+	int init(IPAContext &context, const ValueNode &tuningData) override;
+	int configure(IPAContext &context, const IPAConfigInfo &configInfo) override;
+	void queueRequest(IPAContext &context, const uint32_t frame,
+			  IPAFrameContext &frameContext,
+			  const ControlList &controls) override;
+	void process(IPAContext &context, const uint32_t frame,
+		     IPAFrameContext &frameContext,
+		     const SwIspStats *stats,
+		     ControlList &metadata) override;
+
+private:
+	enum class ScanState {
+		Idle,
+		Warmup,
+		CoarseScan,
+		FineScan,
+		Locked,
+	};
+
+	void startScan(IPAContext &context, bool localOnly);
+	void moveLens(IPAContext &context, int32_t step);
+	double computeScore(const SwIspStats *stats, double &meanLuma) const;
+	float stepToDioptres(int32_t step) const;
+	int32_t dioptresToStep(float dioptres) const;
+
+	bool hasLens_ = false;
+	int32_t hwMinStep_ = 0;
+	int32_t hwMaxStep_ = 1023;
+
+	int32_t scanMinStep_ = 80;
+	int32_t scanMaxStep_ = 940;
+	int32_t coarseStep_ = 60;
+	int32_t fineStep_ = 15;
+	uint32_t warmupFrames_ = 4;
+	uint32_t settleFrames_ = 2;
+	double retriggerRatio_ = 0.72;
+
+	int32_t mode_ = 0;
+	ScanState state_ = ScanState::Idle;
+	uint32_t waitFrames_ = 0;
+	uint32_t defocusStreak_ = 0;
+	uint32_t lockCooldown_ = 0;
+
+	int32_t scanEnd_ = 0;
+	int32_t scanIncrement_ = 0;
+	int32_t currentScanPos_ = 0;
+	int32_t bestPos_ = 0;
+	double bestScore_ = 0.0;
+	double lockedScore_ = 0.0;
+	double lockedLuma_ = 0.0;
+	bool wasLocalScan_ = false;
+};
+
+} /* namespace ipa::soft::algorithms */
+
+} /* namespace libcamera */
