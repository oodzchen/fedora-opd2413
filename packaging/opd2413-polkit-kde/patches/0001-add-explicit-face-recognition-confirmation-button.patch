+namespace {
+
+QDBusMessage createFaceMethodCall(const QString &method)
+{
+    return QDBusMessage::createMethodCall(QStringLiteral("org.opd2413.Face1"),
+                                          QStringLiteral("/org/opd2413/Face1"),
+                                          QStringLiteral("org.opd2413.Face1"),
+                                          method);
+}
+
+} // namespace
+
+QString PolicyKitListener::selectedUsername() const
+{
+    if (!m_selectedUser.isValid()) {
+        return {};
+    }
+    QString idStr = m_selectedUser.toString();
+    if (idStr.startsWith(QLatin1String("unix-user:"))) {
+        return idStr.mid(10);
+    }
+    return idStr;
+}
+
+void PolicyKitListener::disarmFaceAuth()
+{
+    if (m_armedUser.isEmpty()) {
+        return;
+    }
+    QDBusMessage msg = createFaceMethodCall(QStringLiteral("SetPolkitArmed"));
+    msg << m_armedUser << false;
+    m_armedUser.clear();
+    QDBusConnection::systemBus().asyncCall(msg, 1500);
+}
+
+void PolicyKitListener::refreshFaceAvailability()
+{
+    if (m_dialog.isNull()) {
+        return;
+    }
+    m_dialog.data()->setFaceAvailable(false);
+    m_dialog.data()->setFaceScanning(false);
+    m_dialog.data()->setFaceFailed(false);
+
+    const QString username = selectedUsername();
+    if (username.isEmpty()) {
+        return;
+    }
+
+    const quint64 seq = m_authSeq;
+    QDBusMessage msg = createFaceMethodCall(QStringLiteral("HasEnrolled"));
+    msg << username;
+    QDBusPendingCall call = QDBusConnection::systemBus().asyncCall(msg, 1200);
+    auto *watcher = new QDBusPendingCallWatcher(call, this);
+    connect(watcher, &QDBusPendingCallWatcher::finished, this, [this, seq](QDBusPendingCallWatcher *w) {
+        QDBusPendingReply<bool> reply(*w);
+        const bool enrolled = !reply.isError() && reply.value();
+        w->deleteLater();
+        if (!m_inProgress || m_dialog.isNull() || seq != m_authSeq) {
+            return;
+        }
+        m_dialog.data()->setFaceAvailable(enrolled);
+    });
+}
+
+void PolicyKitListener::startFaceAuth()
+{
+    if (!m_inProgress || m_dialog.isNull() || !m_selectedUser.isValid() || m_faceScanning) {
+        return;
+    }
+    const QString username = selectedUsername();
+    if (username.isEmpty()) {
+        return;
+    }
+
+    m_faceScanning = true;
+    m_expectingFaceStatus = true;
+    m_armedUser = username;
+    m_dialog.data()->setFaceFailed(false);
+    m_dialog.data()->setFaceScanning(true);
+    m_dialog.data()->showInfo(i18n("Look at the camera to verify your face…"));
+
+    const quint64 seq = m_authSeq;
+    QDBusMessage msg = createFaceMethodCall(QStringLiteral("SetPolkitArmed"));
+    msg << username << true;
+    QDBusPendingCall call = QDBusConnection::systemBus().asyncCall(msg, 1500);
+    auto *watcher = new QDBusPendingCallWatcher(call, this);
+    connect(watcher, &QDBusPendingCallWatcher::finished, this, [this, seq, username](QDBusPendingCallWatcher *w) {
+        QDBusPendingReply<bool> reply(*w);
+        const bool ok = !reply.isError() && reply.value();
+        w->deleteLater();
+
+        if (!m_inProgress || m_dialog.isNull() || seq != m_authSeq || !m_faceScanning) {
+            if (ok) {
+                QDBusMessage disarm = createFaceMethodCall(QStringLiteral("SetPolkitArmed"));
+                disarm << username << false;
+                QDBusConnection::systemBus().asyncCall(disarm, 1500);
+            }
+            return;
+        }
+
+        if (!ok) {
+            m_faceScanning = false;
+            m_expectingFaceStatus = false;
+            m_armedUser.clear();
+            m_dialog.data()->setFaceScanning(false);
+            m_dialog.data()->setFaceFailed(true, i18n("Face recognition service is unavailable. Please enter your password."));
+            return;
+        }
+
+        if (!m_session.isNull()) {
+            disconnect(m_session.data(), nullptr, this, nullptr);
+            m_session.data()->cancel();
+            m_session.data()->deleteLater();
+            m_session.clear();
+        }
+        tryAgain();
+    });
+}
+
+void PolicyKitListener::onFaceStatusChanged(const QString &state, const QString &detail)
+{
+    if (!m_inProgress || m_dialog.isNull()) {
+        return;
+    }
+    if (!m_expectingFaceStatus && !m_faceScanning) {
+        return;
+    }
+
+    if (state == QLatin1String("scanning")) {
+        if (detail == QLatin1String("polkit-1")) {
+            m_faceScanning = true;
+            m_dialog.data()->setFaceScanning(true);
+        }
+        return;
+    }
+
+    if (state == QLatin1String("matched")) {
+        m_faceScanning = false;
+        m_expectingFaceStatus = false;
+        m_armedUser.clear();
+        m_dialog.data()->setFaceScanning(false);
+        m_dialog.data()->showInfo(i18n("Face recognized, completing authorization…"));
+        return;
+    }
+
+    if (state == QLatin1String("failed") || state == QLatin1String("idle")) {
+        m_faceScanning = false;
+        m_expectingFaceStatus = false;
+        m_armedUser.clear();
+        m_dialog.data()->setFaceScanning(false);
+
+        if (state == QLatin1String("idle")) {
+            return;
+        }
+
+        if (detail == QLatin1String("cancelled")) {
+            m_dialog.data()->clearInlineMessage();
+            return;
+        }
+
+        QString msg;
+        if (detail == QLatin1String("lid-closed")) {
+            msg = i18n("Lid is closed. Open the lid to retry face recognition, or enter your password.");
+        } else if (detail == QLatin1String("busy")) {
+            msg = i18n("Camera is busy. Click Retry Face Recognition or enter your password.");
+        } else if (detail == QLatin1String("timeout") || detail == QLatin1String("no-face")) {
+            msg = i18n("Face not detected. Click Retry Face Recognition or enter your password.");
+        } else {
+            msg = i18n("Face verification failed. Click Retry Face Recognition or enter your password.");
+        }
+        m_dialog.data()->setFaceFailed(true, msg);
+    }
+}
+
