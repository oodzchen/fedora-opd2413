# User systemd service to enter s2idle suspend 10 minutes after lid close.
# PowerDevil handles immediate lock + DPMS Off on lid close (LidAction=64 +
# LockBeforeTurnOffDisplay=true); this watcher starts a 600s timer while the
# lid remains closed and cancels it immediately if the lid reopens.
[Unit]
Description=Delayed suspend after lid close (OPD2413)
PartOf=graphical-session.target
After=graphical-session.target plasma-powerdevil.service

[Service]
Type=simple
Environment=OPD2413_LID_SUSPEND_DELAY=600
ExecStart=/usr/libexec/opd2413/lid-suspend
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical-session.target
